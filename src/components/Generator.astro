                    <div>
                      <label for="wifi-password" class="block text-xs font-semibold text-gray-400 mb-2">Password</label>
                      <input type="password" id="wifi-password" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="Network password" />
                    </div>
                  </div>
                  <div class="grid md:grid-cols-2 gap-4 items-center">
                    <div>
                      <label for="wifi-encryption" class="block text-xs font-semibold text-gray-400 mb-2">Security</label>
                      <select id="wifi-encryption" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors">
                        <option value="WPA">WPA/WPA2</option>
                        <option value="WEP">WEP</option>
                        <option value="nopass">No Security (Open)</option>
                      </select>
                    </div>
                    <div class="flex items-center gap-2 pt-5">
                      <input type="checkbox" id="wifi-hidden" class="rounded border-white/10 bg-slate-950 text-blue-500 focus:ring-0 w-4 h-4 cursor-pointer" />
                      <label for="wifi-hidden" class="text-xs font-semibold text-gray-400 cursor-pointer select-none">Hidden Network?</label>
                    </div>
                  </div>
                </div>

                <!-- vCard Form -->
                <div id="form-vcard" class="form-container space-y-4 hidden">
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="vcard-fn" class="block text-xs font-semibold text-gray-400 mb-2">First Name</label>
                      <input type="text" id="vcard-fn" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="John" />
                    </div>
                    <div>
                      <label for="vcard-ln" class="block text-xs font-semibold text-gray-400 mb-2">Last Name</label>
                      <input type="text" id="vcard-ln" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="Doe" />
                    </div>
                  </div>
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="vcard-phone" class="block text-xs font-semibold text-gray-400 mb-2">Phone</label>
                      <input type="text" id="vcard-phone" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="+1 555 000 000" />
                    </div>
                    <div>
                      <label for="vcard-email" class="block text-xs font-semibold text-gray-400 mb-2">Email Address</label>
                      <input type="email" id="vcard-email" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="john.doe@company.com" />
                    </div>
                  </div>
                  <div class="grid md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                      <label for="vcard-org" class="block text-xs font-semibold text-gray-400 mb-2">Organization / Company</label>
                      <input type="text" id="vcard-org" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="Company Inc." />
                    </div>
                    <div>
                      <label for="vcard-title" class="block text-xs font-semibold text-gray-400 mb-2">Job Title</label>
                      <input type="text" id="vcard-title" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="Manager" />
                    </div>
                  </div>
                  <div>
                    <label for="vcard-url" class="block text-xs font-semibold text-gray-400 mb-2">Website</label>
                    <input type="text" id="vcard-url" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="https://mywebsite.com" />
                  </div>
                </div>

                <!-- Email Form -->
                <div id="form-email" class="form-container space-y-4 hidden">
                  <div class="grid md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                      <label for="email-to" class="block text-xs font-semibold text-gray-400 mb-2">Recipient (Email)</label>
                      <input type="email" id="email-to" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="email@example.com" />
                    </div>
                    <div class="md:col-span-2">
                      <label for="email-subject" class="block text-xs font-semibold text-gray-400 mb-2">Subject</label>
                      <input type="text" id="email-subject" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="Hello from Qreative" />
                    </div>
                  </div>
                  <div>
                    <label for="email-body" class="block text-xs font-semibold text-gray-400 mb-2">Message</label>
                    <textarea id="email-body" rows="3" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors placeholder:text-gray-600" placeholder="Email body content..."></textarea>
                  </div>
                </div>

                <!-- SMS Form -->
                <div id="form-sms" class="form-container space-y-4 hidden">
                  <div>
                    <label for="sms-phone" class="block text-xs font-semibold text-gray-400 mb-2">Phone Number</label>
                    <input type="text" id="sms-phone" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="+1 555 000 000" />
                  </div>
                  <div>
                    <label for="sms-message" class="block text-xs font-semibold text-gray-400 mb-2">Text Message</label>
                    <textarea id="sms-message" rows="3" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors placeholder:text-gray-600" placeholder="SMS message content..."></textarea>
                  </div>
                </div>

              </div>
            </div>

            <!-- SECTION 2: Design Presets -->
            <div class="glass-card rounded-2xl p-6">
              <h2 class="font-display font-bold text-lg text-white mb-4 flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-indigo-500/10 text-indigo-400 text-sm">2</span>
                Save time: Choose a quick design
              </h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                <button data-preset="sunset" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-orange-500 to-zinc-700 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Stealth Carbon</div>
                    <span class="text-[10px] text-gray-500">Orange & Carbon</span>
                  </div>
                </button>
                <button data-preset="cyberpunk" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-cyan-500 to-slate-700 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Stealth Cyber</div>
                    <span class="text-[10px] text-gray-500">Cyan & Steel Gray</span>
                  </div>
                </button>
                <button data-preset="midnight" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-zinc-900 border border-zinc-700 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Obsidian Matte</div>
                    <span class="text-[10px] text-gray-500">Pure Graphite</span>
                  </div>
                </button>
                <button data-preset="forest" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-slate-400 to-slate-600 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Bionic Steel</div>
                    <span class="text-[10px] text-gray-500">Industrial Steel</span>
                  </div>
                </button>
                <button data-preset="royal" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-amber-600 to-orange-900 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Copper Alloy</div>
                    <span class="text-[10px] text-gray-500">Copper & Bronze</span>
                  </div>
                </button>
                <button data-preset="ocean" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-500 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Ocean Blue</div>
                    <span class="text-[10px] text-gray-500">Blue & Cyan</span>
                  </div>
                </button>
                <button data-preset="ink" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-indigo-900 to-sky-500 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Midnight Ink</div>
                    <span class="text-[10px] text-gray-500">Indigo & Sky</span>
                  </div>
                </button>
                <button data-preset="jade" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-emerald-500 to-teal-900 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Jade Circuit</div>
                    <span class="text-[10px] text-gray-500">Emerald & Pine</span>
                  </div>
                </button>
                <button data-preset="rose" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-rose-500 to-amber-400 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Rosé Gold</div>
                    <span class="text-[10px] text-gray-500">Rose & Amber</span>
                  </div>
                </button>
                <button data-preset="violet" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-violet-500 to-fuchsia-500 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Ultra Violet</div>
                    <span class="text-[10px] text-gray-500">Violet & Fuchsia</span>
                  </div>
                </button>
                <button data-preset="executive" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-blue-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-slate-800 border border-slate-600 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Executive</div>
                    <span class="text-[10px] text-gray-500">Graphite on Paper</span>
                  </div>
                </button>
                <button data-preset="standard" class="preset-btn text-left p-3 rounded-xl border border-blue-500/30 bg-slate-950/50 transition-all flex items-center gap-3 active cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-black border border-white/20 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Traditional</div>
                    <span class="text-[10px] text-sky-300">Black & White</span>
                  </div>
                </button>
              </div>
            </div>

            <!-- SECTION 3: Custom Styling Accordion -->
            <div class="glass-card rounded-2xl p-6 space-y-4">
              <h2 class="font-display font-bold text-lg text-white mb-4 flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-sky-500/10 text-sky-400 text-sm">3</span>
                Detailed Customization
              </h2>
              
              <!-- Accordion 1: Puntos (Dots) -->
              <div class="accordion-item border border-white/5 rounded-xl bg-slate-950/20 overflow-hidden">
                <button class="accordion-toggle w-full px-5 py-4 flex items-center justify-between text-sm font-bold text-white hover:bg-white/5 transition-colors cursor-pointer" aria-expanded="false">
                  <span>A. Dots Style &amp; Color</span>
                  <svg class="w-4 h-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <div class="accordion-content p-5 border-t border-white/5 space-y-5 hidden">
                  <!-- Dots Shape -->
                  <div>
                    <span class="block text-xs font-semibold text-gray-400 mb-2">Dots Shape</span>
                    <div class="grid grid-cols-3 gap-2">
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex flex-col items-center justify-center gap-1 text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950 transition-colors">
                        <input type="radio" name="dots-type" value="rounded" class="hidden" checked />
                        <svg class="w-5 h-5" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="6" height="6" rx="2"/><rect x="10" y="2" width="6" height="6" rx="2"/><rect x="2" y="10" width="6" height="6" rx="2"/><rect x="10" y="10" width="6" height="6" rx="2"/></svg>
                        <span>Rounded</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex flex-col items-center justify-center gap-1 text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950 transition-colors">
                        <input type="radio" name="dots-type" value="extra-rounded" class="hidden" />
                        <svg class="w-5 h-5" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="6" height="6" rx="3"/><rect x="10" y="2" width="6" height="6" rx="3"/><rect x="2" y="10" width="6" height="6" rx="3"/><rect x="10" y="10" width="6" height="6" rx="3"/></svg>
                        <span>Extra Rounded</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex flex-col items-center justify-center gap-1 text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950 transition-colors">
                        <input type="radio" name="dots-type" value="dots" class="hidden" />
                        <svg class="w-5 h-5" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true"><circle cx="5" cy="5" r="3.2"/><circle cx="13" cy="5" r="3.2"/><circle cx="5" cy="13" r="3.2"/><circle cx="13" cy="13" r="3.2"/></svg>
                        <span>Circles</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex flex-col items-center justify-center gap-1 text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950 transition-colors">
                        <input type="radio" name="dots-type" value="classy-rounded" class="hidden" />
                        <svg class="w-5 h-5" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="12" height="2.6" rx="1.3"/><rect x="3" y="7.7" width="12" height="2.6" rx="1.3"/><rect x="3" y="12.4" width="12" height="2.6" rx="1.3"/></svg>
