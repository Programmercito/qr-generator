<!-- Workspace Section -->
<section id="generator" class="cyber-grid relative w-full py-16 border-t border-b border-white/5 scroll-mt-20">
  <!-- Decorative Glows for this section specifically -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-orange-600/5 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Section Title -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-orange-500/20 bg-orange-500/5 text-orange-400 text-xs font-semibold uppercase tracking-wider">
        Live Editor
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-black">
        Customize Your QR Code
      </h2>
      <p class="text-gray-400 text-sm">
        Modify the content, apply premium color schemes, or design your own style with a logo.
      </p>
    </div>

    <!-- Glowing Border Wrapper -->
    <div class="animated-glow-border shadow-2xl shadow-orange-500/5">
      <div class="animated-glow-border-content p-6 sm:p-8 lg:p-10">
        
        <div class="grid lg:grid-cols-12 gap-8 items-start">
          
          <!-- LEFT COLUMN: Controls (7 cols on lg) -->
          <section class="lg:col-span-7 space-y-6">
            
            <!-- SECTION 1: Content Type -->
            <div class="glass-card rounded-2xl p-6">
              <h2 class="font-display font-bold text-lg text-white mb-4 flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-orange-500/10 text-orange-400 text-sm">1</span>
                What do you want to encode?
              </h2>
              
              <!-- Content Tabs -->
              <div class="grid grid-cols-5 gap-1.5 p-1 rounded-xl bg-slate-950/50 border border-white/5 mb-6">
                <button data-type="url" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 active bg-white/5 text-orange-400 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                  <span>Link</span>
                </button>
                <button data-type="wifi" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071a10.5 10.5 0 0114.14 0M1.34 6.344a16.5 16.5 0 0121.32 0" /></svg>
                  <span>WiFi</span>
                </button>
                <button data-type="vcard" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M21 12h-4m4 4h-4" /></svg>
                  <span>Contact</span>
                </button>
                <button data-type="email" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                  <span>Email</span>
                </button>
                <button data-type="sms" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                  <span>SMS</span>
                </button>
              </div>

              <!-- Content Forms -->
              <div class="content-forms">
                
                <!-- URL / Text Form -->
                <div id="form-url" class="form-container space-y-4">
                  <div>
                    <label for="url-data" class="block text-xs font-semibold text-gray-400 mb-2">URL Link or Text</label>
                    <textarea 
                      id="url-data" 
                      rows="3" 
                      class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors placeholder:text-gray-600"
                      placeholder="https://example.com or any text to encode..."
                    >https://devcito.org</textarea>
                  </div>
                </div>

                <!-- WiFi Form -->
                <div id="form-wifi" class="form-container space-y-4 hidden">
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="wifi-ssid" class="block text-xs font-semibold text-gray-400 mb-2">Network Name (SSID)</label>
                      <input type="text" id="wifi-ssid" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="My WiFi Network" />
                    </div>
                    <div>
                      <label for="wifi-password" class="block text-xs font-semibold text-gray-400 mb-2">Password</label>
                      <input type="password" id="wifi-password" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="Network password" />
                    </div>
                  </div>
                  <div class="grid md:grid-cols-2 gap-4 items-center">
                    <div>
                      <label for="wifi-encryption" class="block text-xs font-semibold text-gray-400 mb-2">Security</label>
                      <select id="wifi-encryption" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors">
                        <option value="WPA">WPA/WPA2</option>
                        <option value="WEP">WEP</option>
                        <option value="nopass">No Security (Open)</option>
                      </select>
                    </div>
                    <div class="flex items-center gap-2 pt-5">
                      <input type="checkbox" id="wifi-hidden" class="rounded border-white/10 bg-slate-950 text-orange-500 focus:ring-0 w-4 h-4 cursor-pointer" />
                      <label for="wifi-hidden" class="text-xs font-semibold text-gray-400 cursor-pointer select-none">Hidden Network?</label>
                    </div>
                  </div>
                </div>

                <!-- vCard Form -->
                <div id="form-vcard" class="form-container space-y-4 hidden">
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="vcard-fn" class="block text-xs font-semibold text-gray-400 mb-2">First Name</label>
                      <input type="text" id="vcard-fn" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="John" />
                    </div>
                    <div>
                      <label for="vcard-ln" class="block text-xs font-semibold text-gray-400 mb-2">Last Name</label>
                      <input type="text" id="vcard-ln" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="Doe" />
                    </div>
                  </div>
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="vcard-phone" class="block text-xs font-semibold text-gray-400 mb-2">Phone</label>
                      <input type="text" id="vcard-phone" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="+1 555 000 000" />
                    </div>
                    <div>
                      <label for="vcard-email" class="block text-xs font-semibold text-gray-400 mb-2">Email Address</label>
                      <input type="email" id="vcard-email" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="john.doe@company.com" />
                    </div>
                  </div>
                  <div class="grid md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                      <label for="vcard-org" class="block text-xs font-semibold text-gray-400 mb-2">Organization / Company</label>
                      <input type="text" id="vcard-org" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="Company Inc." />
                    </div>
                    <div>
                      <label for="vcard-title" class="block text-xs font-semibold text-gray-400 mb-2">Job Title</label>
                      <input type="text" id="vcard-title" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="Manager" />
                    </div>
                  </div>
                  <div>
                    <label for="vcard-url" class="block text-xs font-semibold text-gray-400 mb-2">Website</label>
                    <input type="text" id="vcard-url" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="https://mywebsite.com" />
                  </div>
                </div>

                <!-- Email Form -->
                <div id="form-email" class="form-container space-y-4 hidden">
                  <div class="grid md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                      <label for="email-to" class="block text-xs font-semibold text-gray-400 mb-2">Recipient (Email)</label>
                      <input type="email" id="email-to" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="email@example.com" />
                    </div>
                    <div class="md:col-span-2">
                      <label for="email-subject" class="block text-xs font-semibold text-gray-400 mb-2">Subject</label>
                      <input type="text" id="email-subject" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="Hello from Qreative" />
                    </div>
                  </div>
                  <div>
                    <label for="email-body" class="block text-xs font-semibold text-gray-400 mb-2">Message</label>
                    <textarea id="email-body" rows="3" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors placeholder:text-gray-600" placeholder="Email body content..."></textarea>
                  </div>
                </div>

                <!-- SMS Form -->
                <div id="form-sms" class="form-container space-y-4 hidden">
                  <div>
                    <label for="sms-phone" class="block text-xs font-semibold text-gray-400 mb-2">Phone Number</label>
                    <input type="text" id="sms-phone" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors" placeholder="+1 555 000 000" />
                  </div>
                  <div>
                    <label for="sms-message" class="block text-xs font-semibold text-gray-400 mb-2">Text Message</label>
                    <textarea id="sms-message" rows="3" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-orange-500/50 transition-colors placeholder:text-gray-600" placeholder="SMS message content..."></textarea>
                  </div>
                </div>

              </div>
            </div>

            <!-- SECTION 2: Design Presets -->
            <div class="glass-card rounded-2xl p-6">
              <h2 class="font-display font-bold text-lg text-white mb-4 flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400 text-sm">2</span>
                Save time: Choose a quick design
              </h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                <button data-preset="sunset" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-orange-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-orange-500 to-zinc-700 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Stealth Carbon</div>
                    <span class="text-[10px] text-gray-500">Orange & Carbon</span>
                  </div>
                </button>
                <button data-preset="cyberpunk" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-orange-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-cyan-500 to-slate-700 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Stealth Cyber</div>
                    <span class="text-[10px] text-gray-500">Cyan & Steel Gray</span>
                  </div>
                </button>
                <button data-preset="midnight" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-orange-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-zinc-900 border border-zinc-700 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Obsidian Matte</div>
                    <span class="text-[10px] text-gray-500">Pure Graphite</span>
                  </div>
                </button>
                <button data-preset="forest" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-orange-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-slate-400 to-slate-600 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Bionic Steel</div>
                    <span class="text-[10px] text-gray-500">Industrial Steel</span>
                  </div>
                </button>
                <button data-preset="royal" class="preset-btn text-left p-3 rounded-xl border border-white/5 hover:border-orange-500/30 bg-slate-950/30 transition-all flex items-center gap-3 cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-amber-600 to-orange-850 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Copper Alloy</div>
                    <span class="text-[10px] text-gray-500">Copper & Bronze</span>
                  </div>
                </button>
                <button data-preset="standard" class="preset-btn text-left p-3 rounded-xl border border-orange-500/30 bg-slate-950/50 transition-all flex items-center gap-3 active cursor-pointer">
                  <span class="w-6 h-6 rounded-full bg-black border border-white/20 flex-shrink-0"></span>
                  <div>
                    <div class="text-xs font-bold text-white leading-none">Traditional</div>
                    <span class="text-[10px] text-orange-400">Black & White</span>
                  </div>
                </button>
              </div>
            </div>

            <!-- SECTION 3: Custom Styling Accordion -->
            <div class="glass-card rounded-2xl p-6 space-y-4">
              <h2 class="font-display font-bold text-lg text-white mb-4 flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-red-500/10 text-red-400 text-sm">3</span>
                Detailed Customization
              </h2>
              
              <!-- Accordion 1: Puntos (Dots) -->
              <div class="accordion-item border border-white/5 rounded-xl bg-slate-950/20 overflow-hidden">
                <button class="accordion-toggle w-full px-5 py-4 flex items-center justify-between text-sm font-bold text-white hover:bg-white/5 transition-colors cursor-pointer">
                  <span>A. Dots Style & Color</span>
                  <svg class="w-4 h-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <div class="accordion-content p-5 border-t border-white/5 space-y-5 hidden">
                  <!-- Dots Shape -->
                  <div>
                    <span class="block text-xs font-semibold text-gray-400 mb-2">Dots Shape</span>
                    <div class="grid grid-cols-3 gap-2">
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                        <input type="radio" name="dots-type" value="rounded" class="hidden" checked />
                        <span>Rounded</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                        <input type="radio" name="dots-type" value="extra-rounded" class="hidden" />
                        <span>Extra Rounded</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                        <input type="radio" name="dots-type" value="dots" class="hidden" />
                        <span>Circles</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                        <input type="radio" name="dots-type" value="classy-rounded" class="hidden" />
                        <span>Classy Rounded</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                        <input type="radio" name="dots-type" value="classy" class="hidden" />
                        <span>Classy Lines</span>
                      </label>
                      <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                        <input type="radio" name="dots-type" value="square" class="hidden" />
                        <span>Square</span>
                      </label>
                    </div>
                  </div>
                  
                  <!-- Dots Color Mode -->
                  <div>
                    <span class="block text-xs font-semibold text-gray-400 mb-2">Color Mode</span>
                    <div class="flex gap-4">
                      <label class="flex items-center gap-2 text-xs text-gray-300 cursor-pointer select-none">
                        <input type="radio" name="dots-color-mode" value="solid" checked class="rounded border-white/10 bg-slate-950 text-orange-500 focus:ring-0" />
                        Solid Color
                      </label>
                      <label class="flex items-center gap-2 text-xs text-gray-300 cursor-pointer select-none">
                        <input type="radio" name="dots-color-mode" value="gradient" class="rounded border-white/10 bg-slate-950 text-orange-500 focus:ring-0" />
                        Gradient
                      </label>
                    </div>
                  </div>

                  <!-- Solid Color Choice -->
                  <div id="dots-solid-options" class="flex items-center gap-3">
                    <div class="relative w-10 h-10 rounded-lg overflow-hidden border border-white/10 flex-shrink-0">
                      <input type="color" id="dots-color" value="#000000" class="absolute -inset-2 w-14 h-14 cursor-pointer" />
                    </div>
                    <div>
                      <span class="block text-xs font-semibold text-white leading-none">Dots Color</span>
                      <span class="text-[10px] text-gray-500">Select primary fill tone</span>
                    </div>
                  </div>

                  <!-- Gradient Options -->
                  <div id="dots-gradient-options" class="space-y-4 hidden">
                    <div class="grid grid-cols-2 gap-4">
                      <div class="flex items-center gap-3">
                        <div class="relative w-10 h-10 rounded-lg overflow-hidden border border-white/10 flex-shrink-0">
                          <input type="color" id="dots-grad-color1" value="#6366f1" class="absolute -inset-2 w-14 h-14 cursor-pointer" />
                        </div>
                        <div>
                          <span class="block text-xs font-semibold text-white">Color 1 (Start)</span>
                        </div>
                      </div>
                      <div class="flex items-center gap-3">
                        <div class="relative w-10 h-10 rounded-lg overflow-hidden border border-white/10 flex-shrink-0">
                          <input type="color" id="dots-grad-color2" value="#ec4899" class="absolute -inset-2 w-14 h-14 cursor-pointer" />
                        </div>
                        <div>
                          <span class="block text-xs font-semibold text-white">Color 2 (End)</span>
                        </div>
                      </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                      <div>
                        <label for="dots-grad-type" class="block text-xs font-semibold text-gray-400 mb-2">Gradient Type</label>
                        <select id="dots-grad-type" class="w-full bg-slate-950 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:ring-0">
                          <option value="linear">Linear</option>
                          <option value="radial">Radial</option>
                        </select>
                      </div>
                      <div>
                        <label for="dots-grad-rotation" class="block text-xs font-semibold text-gray-400 mb-2">Rotation Angle</label>
                        <div class="flex items-center gap-2">
                          <input type="range" id="dots-grad-rotation" min="0" max="360" value="45" class="w-full h-1 bg-white/10 rounded-lg appearance-none cursor-pointer accent-orange-500" />
                          <span id="dots-grad-rotation-value" class="text-xs text-gray-300 font-mono">45°</span>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>

              <!-- Accordion 2: Esquinas (Corners) -->
              <div class="accordion-item border border-white/5 rounded-xl bg-slate-950/20 overflow-hidden">
                <button class="accordion-toggle w-full px-5 py-4 flex items-center justify-between text-sm font-bold text-white hover:bg-white/5 transition-colors cursor-pointer">
                  <span>B. Corner Styles (Finders)</span>
                  <svg class="w-4 h-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <div class="accordion-content p-5 border-t border-white/5 space-y-6 hidden">
                  <!-- Outer Square -->
                  <div class="space-y-4">
                    <h3 class="text-xs font-bold text-orange-400 uppercase tracking-wider">Corner Frame (Outer)</h3>
                    <div>
                      <span class="block text-xs font-semibold text-gray-400 mb-2">Frame Shape</span>
                      <div class="grid grid-cols-3 gap-2">
                        <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                          <input type="radio" name="corners-square-type" value="extra-rounded" class="hidden" checked />
                          <span>Rounded</span>
                        </label>
                        <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                          <input type="radio" name="corners-square-type" value="dot" class="hidden" />
                          <span>Circle</span>
                        </label>
                        <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                          <input type="radio" name="corners-square-type" value="square" class="hidden" />
                          <span>Square</span>
                        </label>
                      </div>
                    </div>
                    
                    <div class="flex items-center gap-3">
                      <div class="relative w-10 h-10 rounded-lg overflow-hidden border border-white/10 flex-shrink-0">
                        <input type="color" id="corners-square-color" value="#000000" class="absolute -inset-2 w-14 h-14 cursor-pointer" />
                      </div>
                      <div>
                        <span class="block text-xs font-semibold text-white">Frame Color</span>
                        <span class="text-[10px] text-gray-500">Custom color for outer frames</span>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Inner Dot -->
                  <div class="space-y-4 pt-4 border-t border-white/5">
                    <h3 class="text-xs font-bold text-red-400 uppercase tracking-wider">Corner Center (Inner)</h3>
                    <div>
                      <span class="block text-xs font-semibold text-gray-400 mb-2">Center Shape</span>
                      <div class="grid grid-cols-2 gap-2">
                        <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                          <input type="radio" name="corners-dot-type" value="dot" class="hidden" checked />
                          <span>Circle</span>
                        </label>
                        <label class="cursor-pointer border border-white/5 rounded-xl p-2.5 flex items-center justify-center text-center text-xs font-semibold text-gray-400 hover:text-white bg-slate-950/50 hover:bg-slate-950">
                          <input type="radio" name="corners-dot-type" value="square" class="hidden" />
                          <span>Square</span>
                        </label>
                      </div>
                    </div>

                    <div class="flex items-center gap-3">
                      <div class="relative w-10 h-10 rounded-lg overflow-hidden border border-white/10 flex-shrink-0">
                        <input type="color" id="corners-dot-color" value="#000000" class="absolute -inset-2 w-14 h-14 cursor-pointer" />
                      </div>
                      <div>
                        <span class="block text-xs font-semibold text-white">Center Color</span>
                        <span class="text-[10px] text-gray-500">Custom color for inner dots</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Accordion 3: Fondo (Background) -->
              <div class="accordion-item border border-white/5 rounded-xl bg-slate-950/20 overflow-hidden">
                <button class="accordion-toggle w-full px-5 py-4 flex items-center justify-between text-sm font-bold text-white hover:bg-white/5 transition-colors cursor-pointer">
                  <span>C. QR Code Background</span>
                  <svg class="w-4 h-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <div class="accordion-content p-5 border-t border-white/5 space-y-4 hidden">
                  <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                      <div class="relative w-10 h-10 rounded-lg overflow-hidden border border-white/10 flex-shrink-0" id="bg-color-picker-wrapper">
                        <input type="color" id="bg-color" value="#ffffff" class="absolute -inset-2 w-14 h-14 cursor-pointer" />
                      </div>
                      <div>
                        <span class="block text-xs font-semibold text-white">Background Color</span>
                        <span class="text-[10px] text-gray-500">Light colors or white are recommended</span>
                      </div>
                    </div>
                    
                    <div class="flex items-center gap-2">
                      <input type="checkbox" id="bg-transparent" class="rounded border-white/10 bg-slate-950 text-orange-500 focus:ring-0 w-4 h-4 cursor-pointer" />
                      <label for="bg-transparent" class="text-xs font-semibold text-gray-400 cursor-pointer select-none">Transparent Background</label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Accordion 4: Logotipo (Logo) -->
              <div class="accordion-item border border-white/5 rounded-xl bg-slate-950/20 overflow-hidden">
                <button class="accordion-toggle w-full px-5 py-4 flex items-center justify-between text-sm font-bold text-white hover:bg-white/5 transition-colors cursor-pointer">
                  <span>D. Insert Your Logo</span>
                  <svg class="w-4 h-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <div class="accordion-content p-5 border-t border-white/5 space-y-5 hidden">
                  <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-2">Logo File (PNG, JPG, SVG)</label>
                    <div class="flex items-center gap-3">
                      <input type="file" id="logo-file" accept="image/*" class="hidden" />
                      <button type="button" id="logo-upload-btn" class="px-4 py-2.5 rounded-xl border border-white/10 bg-slate-950/50 hover:bg-slate-950 text-xs font-bold text-white transition-all cursor-pointer">
                        Choose Image
                      </button>
                      <button type="button" id="logo-remove-btn" class="px-4 py-2.5 rounded-xl border border-red-500/20 bg-red-500/10 hover:bg-red-500/20 text-xs font-bold text-red-400 transition-all hidden cursor-pointer">
                        Remove Logo
                      </button>
                      <span id="logo-filename" class="text-xs text-gray-500 truncate max-w-[180px]">No file selected</span>
                    </div>
                  </div>
                  
                  <div class="space-y-4 pt-2">
                    <div>
                      <div class="flex justify-between items-center text-xs text-gray-400 mb-2">
                        <span>Logo Size</span>
                        <span id="logo-size-val" class="font-mono text-white text-xs">20%</span>
                      </div>
                      <input type="range" id="logo-size" min="5" max="35" value="20" class="w-full h-1 bg-white/10 rounded-lg appearance-none cursor-pointer accent-orange-500" />
                    </div>
                    
                    <div>
                      <div class="flex justify-between items-center text-xs text-gray-400 mb-2">
                        <span>Logo Padding (Margin)</span>
                        <span id="logo-margin-val" class="font-mono text-white text-xs">5px</span>
                      </div>
                      <input type="range" id="logo-margin" min="0" max="20" value="5" class="w-full h-1 bg-white/10 rounded-lg appearance-none cursor-pointer accent-orange-500" />
                    </div>
                    
                    <div class="flex items-center gap-2">
                      <input type="checkbox" id="logo-clear" checked class="rounded border-white/10 bg-slate-950 text-orange-500 focus:ring-0 w-4 h-4 cursor-pointer" />
                      <label for="logo-clear" class="text-xs font-semibold text-gray-400 cursor-pointer select-none">Clear background behind logo</label>
                    </div>
                  </div>
                </div>
              </div>

            </div>

          </section>

          <!-- RIGHT COLUMN: Preview & Download (5 cols on lg) -->
          <section class="lg:col-span-5 sticky top-24 space-y-6">
            
            <!-- Live Preview Container -->
            <div class="relative rounded-3xl p-1 bg-gradient-to-tr from-orange-500/20 via-amber-500/10 to-transparent border border-white/5">
              <div class="glass-card rounded-[22px] p-8 flex flex-col items-center">
                
                <div class="w-full flex items-center justify-between border-b border-white/5 pb-4 mb-6">
                  <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Live Preview</span>
                  <button id="reset-btn" class="text-xs font-semibold text-orange-400 hover:text-orange-300 transition-colors flex items-center gap-1 cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18" /></svg>
                    Reset
                  </button>
                </div>
                
                <!-- Canvas target container -->
                <div id="qr-target" class="relative p-6 rounded-2xl bg-white flex items-center justify-center shadow-2xl transition-all duration-300 select-none min-h-[290px] min-w-[290px]">
                  <!-- We will append the canvas here -->
                  <div id="qr-spinner" class="absolute inset-0 flex items-center justify-center bg-white rounded-2xl">
                    <svg class="animate-spin h-8 w-8 text-orange-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </div>
                </div>

                <!-- Export Formats & Download Button -->
                <div class="w-full space-y-4 mt-8">
                  <div class="grid grid-cols-3 gap-2">
                    <button data-format="png" class="format-btn py-2 text-xs font-bold rounded-xl border border-orange-500/30 bg-orange-500/10 text-orange-400 transition-all cursor-pointer">
                      PNG
                    </button>
                    <button data-format="svg" class="format-btn py-2 text-xs font-bold rounded-xl border border-white/5 bg-slate-950/40 text-gray-400 hover:text-white transition-all cursor-pointer">
                      SVG
                    </button>
                    <button data-format="jpeg" class="format-btn py-2 text-xs font-bold rounded-xl border border-white/5 bg-slate-950/40 text-gray-400 hover:text-white transition-all cursor-pointer">
                      JPEG
                    </button>
                  </div>
                  
                  <button 
                    id="download-btn"
                    class="glow-btn relative w-full inline-flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-white bg-gradient-to-r from-orange-600 via-amber-500 to-yellow-500 shadow-xl shadow-orange-500/20 hover:scale-[1.01] active:scale-[0.99] transition-all duration-200 cursor-pointer"
                  >
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                    Download QR Code
                  </button>

                  <button 
                    id="copy-btn"
                    class="w-full py-3.5 rounded-xl border border-white/10 hover:bg-white/5 text-gray-300 font-semibold text-xs transition-colors flex items-center justify-center gap-2 cursor-pointer"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                    Copy Image to Clipboard
                  </button>
                </div>
                
              </div>
            </div>

            <div class="glass-panel p-5 rounded-2xl border border-white/5 space-y-2.5">
              <h4 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-4 h-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Scanning Tip
              </h4>
              <p class="text-xs text-gray-400 leading-relaxed">
                Maintain adequate contrast between the dots (dark) and background (light). If adding a logo, size above 25% might affect scanning on older devices.
              </p>
            </div>

          </section>
          
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* Accordion Item styles */
  .accordion-item .accordion-toggle svg {
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .accordion-item.active .accordion-toggle svg {
    transform: rotate(180deg);
  }
  
  /* Form style helper */
  .form-container {
    transition: all 0.2s ease;
  }
  
  /* Input range customizing */
  input[type="range"]::-webkit-slider-thumb {
    box-shadow: 0 0 10px rgba(249, 115, 22, 0.5);
  }

  /* Style selected states for custom radio tabs */
  label:has(input[type="radio"]:checked) {
    border-color: rgba(249, 115, 22, 0.4);
    background-color: rgba(15, 23, 42, 0.9);
    color: #f97316;
  }
</style>

<script>
  // Dynamic import of qr-code-styling to support client-only execution in Astro
  document.addEventListener('DOMContentLoaded', async () => {
    let QRCodeStyling;
    try {
      const module = await import('qr-code-styling');
      QRCodeStyling = module.default;
    } catch (err) {
      console.error('Failed to load qr-code-styling module:', err);
      return;
    }

    const qrTarget = document.getElementById('qr-target');
    const qrSpinner = document.getElementById('qr-spinner');
    
    // Hide spinner once loaded
    if (qrSpinner) qrSpinner.style.display = 'none';

    // State Variables
    let currentDataType = 'url';
    let currentFormat = 'png';
    let uploadedLogoDataUrl = null;
    let isInitialized = false;
    let updateTimeout = null;

    // Default configuration options
    const defaultOptions = {
      width: 280,
      height: 280,
      type: 'canvas',
      data: 'https://devcito.org',
      margin: 8,
      qrOptions: {
        typeNumber: 0,
        mode: 'Byte',
        errorCorrectionLevel: 'H'
      },
      imageOptions: {
        hideBackgroundDots: true,
        imageSize: 0.2,
        margin: 5
      },
      dotsOptions: {
        type: 'rounded',
        color: '#000000'
      },
      backgroundOptions: {
        color: '#ffffff'
      },
      cornersSquareOptions: {
        type: 'extra-rounded',
        color: '#000000'
      },
      cornersDotOptions: {
        type: 'dot',
        color: '#000000'
      }
    };

    // Instantiate qr-code-styling
    const qrCode = new QRCodeStyling(defaultOptions);
    if (qrTarget) {
      qrCode.append(qrTarget);
    }

    // --- ACCORDION LOGIC ---
    const accordionToggles = document.querySelectorAll('.accordion-toggle');
    accordionToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const item = toggle.parentElement;
        const content = toggle.nextElementSibling;
        
        const isClosed = content.classList.contains('hidden');
        
        // Close all first
        document.querySelectorAll('.accordion-content').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('active'));
        
        if (isClosed) {
          content.classList.remove('hidden');
          item.classList.add('active');
        }
      });
    });
    // Open first accordion item by default
    const firstAccordion = document.querySelector('.accordion-item');
    if (firstAccordion) {
      firstAccordion.classList.add('active');
      firstAccordion.querySelector('.accordion-content').classList.remove('hidden');
    }

    // --- STATE UPDATE FUNCTION ---
    function updateQR() {
      // 1. Gather Data based on selected tab
      let qrData = 'https://devcito.org';
      if (currentDataType === 'url') {
        qrData = document.getElementById('url-data').value || 'https://devcito.org';
      } else if (currentDataType === 'wifi') {
        const ssid = document.getElementById('wifi-ssid').value || '';
        const pass = document.getElementById('wifi-password').value || '';
        const enc = document.getElementById('wifi-encryption').value || 'WPA';
        const hidden = document.getElementById('wifi-hidden').checked;
        qrData = `WIFI:S:${ssid};T:${enc};P:${pass};H:${hidden ? 'true' : 'false'};;`;
      } else if (currentDataType === 'vcard') {
        const fn = document.getElementById('vcard-fn').value || '';
        const ln = document.getElementById('vcard-ln').value || '';
        const phone = document.getElementById('vcard-phone').value || '';
        const email = document.getElementById('vcard-email').value || '';
        const org = document.getElementById('vcard-org').value || '';
        const title = document.getElementById('vcard-title').value || '';
        const url = document.getElementById('vcard-url').value || '';
        qrData = `BEGIN:VCARD\nVERSION:3.0\nN:${ln};${fn};;;\nFN:${fn} ${ln}\nORG:${org}\nTITLE:${title}\nTEL;TYPE=CELL:${phone}\nEMAIL;TYPE=PREF,INTERNET:${email}\nURL:${url}\nEND:VCARD`;
      } else if (currentDataType === 'email') {
        const to = document.getElementById('email-to').value || '';
        const sub = document.getElementById('email-subject').value || '';
        const body = document.getElementById('email-body').value || '';
        qrData = `mailto:${to}?subject=${encodeURIComponent(sub)}&body=${encodeURIComponent(body)}`;
      } else if (currentDataType === 'sms') {
        const phone = document.getElementById('sms-phone').value || '';
        const message = document.getElementById('sms-message').value || '';
        qrData = `SMSTO:${phone}:${message}`;
      }

      // 2. Gather Dot Styling Options
      const dotsShape = document.querySelector('input[name="dots-type"]:checked').value;
      const dotsColorMode = document.querySelector('input[name="dots-color-mode"]:checked').value;
      
      let dotsOptionsObj = { type: dotsShape };
      if (dotsColorMode === 'solid') {
        dotsOptionsObj.color = document.getElementById('dots-color').value;
        dotsOptionsObj.gradient = null;
      } else {
        const color1 = document.getElementById('dots-grad-color1').value;
        const color2 = document.getElementById('dots-grad-color2').value;
        const type = document.getElementById('dots-grad-type').value;
        const rotation = parseInt(document.getElementById('dots-grad-rotation').value) * Math.PI / 180;
        
        dotsOptionsObj.color = color1; // fallback
        dotsOptionsObj.gradient = {
          type: type,
          rotation: rotation,
          colorStops: [
            { offset: 0, color: color1 },
            { offset: 1, color: color2 }
          ]
        };
      }

      // 3. Corner Options
      const cornerSquareShape = document.querySelector('input[name="corners-square-type"]:checked').value;
      const cornerSquareColor = document.getElementById('corners-square-color').value;
      const cornerDotShape = document.querySelector('input[name="corners-dot-type"]:checked').value;
      const cornerDotColor = document.getElementById('corners-dot-color').value;

      // 4. Background Options
      const bgTransparent = document.getElementById('bg-transparent').checked;
      const bgColor = bgTransparent ? 'transparent' : document.getElementById('bg-color').value;

      // 5. Logo options
      const logoSize = parseFloat(document.getElementById('logo-size').value) / 100;
      const logoMargin = parseInt(document.getElementById('logo-margin').value);
      const logoClear = document.getElementById('logo-clear').checked;

      // Combine Options
      const updatedOptions = {
        data: qrData,
        dotsOptions: dotsOptionsObj,
        backgroundOptions: {
          color: bgColor
        },
        cornersSquareOptions: {
          type: cornerSquareShape,
          color: cornerSquareColor
        },
        cornersDotOptions: {
          type: cornerDotShape,
          color: cornerDotColor
        },
        image: uploadedLogoDataUrl || '',
        imageOptions: {
          hideBackgroundDots: logoClear,
          imageSize: logoSize,
          margin: logoMargin,
          crossOrigin: 'anonymous'
        }
      };

      // Set target background helper
      if (qrTarget) {
        qrTarget.style.backgroundColor = bgTransparent ? '#0f172a' : '#ffffff';
        // Add checkered overlay for transparency indicator if transparent
        if (bgTransparent) {
          qrTarget.style.backgroundImage = 'radial-gradient(rgba(255,255,255,0.15) 1px, transparent 0)';
          qrTarget.style.backgroundSize = '12px 12px';
        } else {
          qrTarget.style.backgroundImage = 'none';
        }
      }

      if (isInitialized && qrTarget) {
        if (!qrTarget.classList.contains('qr-updating')) {
          qrTarget.classList.remove('qr-flash');
          qrTarget.classList.add('qr-updating');
        }
      }

      qrCode.update(updatedOptions);

      if (isInitialized && qrTarget) {
        if (updateTimeout) {
          clearTimeout(updateTimeout);
        }
        
        updateTimeout = setTimeout(() => {
          if (qrTarget) {
            qrTarget.classList.remove('qr-updating');
            qrTarget.classList.add('qr-flash');
            
            // Remove flash class after its animation ends
            setTimeout(() => {
              if (qrTarget) {
                qrTarget.classList.remove('qr-flash');
              }
            }, 600);
          }
        }, 300);
      }
    }

    // --- FORM SWITCHING LOGIC ---
    const tabBtns = document.querySelectorAll('.tab-btn');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle tabs active class
        tabBtns.forEach(b => {
          b.classList.remove('active', 'bg-white/5', 'text-orange-400');
        });
        btn.classList.add('active', 'bg-white/5', 'text-orange-400');

        // Toggle visibility of target forms
        const targetType = btn.getAttribute('data-type');
        currentDataType = targetType;
        
        // Hide all first
        const allForms = document.querySelectorAll('.content-forms > div');
        allForms.forEach(f => f.classList.add('hidden'));
        
        // Show target
        const targetForm = document.getElementById(`form-${targetType}`);
        if (targetForm) {
          targetForm.classList.remove('hidden');
        }
        
        updateQR();
      });
    });

    // --- COLOR MODE SWITCHING ---
    const colorModeRadios = document.querySelectorAll('input[name="dots-color-mode"]');
    const solidChoice = document.getElementById('dots-solid-options');
    const gradChoice = document.getElementById('dots-gradient-options');
    
    colorModeRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        if (e.target.value === 'solid') {
          solidChoice.classList.remove('hidden');
          gradChoice.classList.add('hidden');
        } else {
          solidChoice.classList.add('hidden');
          gradChoice.classList.remove('hidden');
        }
        updateQR();
      });
    });

    // --- BACKGROUND TRANSPARENCY TOGGLE ---
    const bgTransparentCheckbox = document.getElementById('bg-transparent');
    const bgColorWrapper = document.getElementById('bg-color-picker-wrapper');
    bgTransparentCheckbox.addEventListener('change', (e) => {
      if (e.target.checked) {
        bgColorWrapper.style.opacity = '0.3';
        bgColorWrapper.style.pointerEvents = 'none';
      } else {
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';
      }
      updateQR();
    });

    // --- LOGO UPLOAD & PROCESSING ---
    const logoFile = document.getElementById('logo-file');
    const logoUploadBtn = document.getElementById('logo-upload-btn');
    const logoRemoveBtn = document.getElementById('logo-remove-btn');
    const logoFilename = document.getElementById('logo-filename');

    logoUploadBtn.addEventListener('click', () => logoFile.click());
    
    logoFile.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        logoFilename.textContent = file.name;
        logoRemoveBtn.classList.remove('hidden');
        
        const reader = new FileReader();
        reader.onload = (event) => {
          uploadedLogoDataUrl = event.target.result;
          updateQR();
        };
        reader.readAsDataURL(file);
      }
    });

    logoRemoveBtn.addEventListener('click', () => {
      uploadedLogoDataUrl = null;
      logoFile.value = '';
      logoFilename.textContent = 'No file selected';
      logoRemoveBtn.classList.add('hidden');
      updateQR();
    });

    // --- LOGO SLIDERS REAL-TIME DISPLAY ---
    const logoSizeSlider = document.getElementById('logo-size');
    const logoSizeVal = document.getElementById('logo-size-val');
    logoSizeSlider.addEventListener('input', (e) => {
      logoSizeVal.textContent = `${e.target.value}%`;
      updateQR();
    });

    const logoMarginSlider = document.getElementById('logo-margin');
    const logoMarginVal = document.getElementById('logo-margin-val');
    logoMarginSlider.addEventListener('input', (e) => {
      logoMarginVal.textContent = `${e.target.value}px`;
      updateQR();
    });

    const dotsGradRotationSlider = document.getElementById('dots-grad-rotation');
    const dotsGradRotationVal = document.getElementById('dots-grad-rotation-value');
    dotsGradRotationSlider.addEventListener('input', (e) => {
      dotsGradRotationVal.textContent = `${e.target.value}°`;
      updateQR();
    });

    // --- INPUT EVENT LISTENERS ---
    const inputsToWatch = [
      'url-data', 'wifi-ssid', 'wifi-password', 'wifi-encryption', 'wifi-hidden',
      'vcard-fn', 'vcard-ln', 'vcard-phone', 'vcard-email', 'vcard-org', 'vcard-title', 'vcard-url',
      'email-to', 'email-subject', 'email-body',
      'sms-phone', 'sms-message',
      'dots-color', 'dots-grad-color1', 'dots-grad-color2', 'dots-grad-type', 'dots-grad-rotation',
      'corners-square-color', 'corners-dot-color', 'bg-color', 'logo-clear'
    ];
    inputsToWatch.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', updateQR);
        el.addEventListener('change', updateQR);
      }
    });

    const radiosToWatch = ['dots-type', 'corners-square-type', 'corners-dot-type'];
    radiosToWatch.forEach(name => {
      document.querySelectorAll(`input[name="${name}"]`).forEach(radio => {
        radio.addEventListener('change', updateQR);
      });
    });

    // --- DESIGN PRESETS HANDLER ---
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle Active
        presetBtns.forEach(b => {
          b.classList.remove('active', 'border-orange-500/30', 'bg-slate-950/50');
          b.classList.add('border-white/5', 'bg-slate-950/30');
        });
        btn.classList.add('active', 'border-orange-500/30', 'bg-slate-950/50');
        btn.classList.remove('border-white/5', 'bg-slate-950/30');

        const preset = btn.getAttribute('data-preset');
        applyPreset(preset);
      });
    });

    function applyPreset(name) {
      if (name === 'sunset') {
        // Stealth Carbon preset
        // Dots
        setRadioVal('dots-type', 'classy-rounded');
        setRadioVal('dots-color-mode', 'gradient');
        solidChoice.classList.add('hidden');
        gradChoice.classList.remove('hidden');
        document.getElementById('dots-grad-color1').value = '#f97316';
        document.getElementById('dots-grad-color2').value = '#27272a';
        document.getElementById('dots-grad-type').value = 'linear';
        document.getElementById('dots-grad-rotation').value = '45';
        dotsGradRotationVal.textContent = '45°';

        // Corners
        setRadioVal('corners-square-type', 'extra-rounded');
        document.getElementById('corners-square-color').value = '#f97316';
        setRadioVal('corners-dot-type', 'dot');
        document.getElementById('corners-dot-color').value = '#71717a';

        // Background
        document.getElementById('bg-transparent').checked = false;
        document.getElementById('bg-color').value = '#ffffff';
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';

      } else if (name === 'cyberpunk') {
        // Stealth Cyber preset
        // Dots
        setRadioVal('dots-type', 'dots');
        setRadioVal('dots-color-mode', 'gradient');
        solidChoice.classList.add('hidden');
        gradChoice.classList.remove('hidden');
        document.getElementById('dots-grad-color1').value = '#00f5ff';
        document.getElementById('dots-grad-color2').value = '#3f3f46';
        document.getElementById('dots-grad-type').value = 'linear';
        document.getElementById('dots-grad-rotation').value = '90';
        dotsGradRotationVal.textContent = '90°';

        // Corners
        setRadioVal('corners-square-type', 'square');
        document.getElementById('corners-square-color').value = '#00f5ff';
        setRadioVal('corners-dot-type', 'square');
        document.getElementById('corners-dot-color').value = '#71717a';

        // Background
        document.getElementById('bg-transparent').checked = false;
        document.getElementById('bg-color').value = '#07080a';
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';

      } else if (name === 'midnight') {
        // Obsidian Matte preset
        // Dots
        setRadioVal('dots-type', 'rounded');
        setRadioVal('dots-color-mode', 'solid');
        solidChoice.classList.remove('hidden');
        gradChoice.classList.add('hidden');
        document.getElementById('dots-color').value = '#18181b';

        // Corners
        setRadioVal('corners-square-type', 'extra-rounded');
        document.getElementById('corners-square-color').value = '#18181b';
        setRadioVal('corners-dot-type', 'dot');
        document.getElementById('corners-dot-color').value = '#27272a';

        // Background
        document.getElementById('bg-transparent').checked = false;
        document.getElementById('bg-color').value = '#f4f4f5';
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';

      } else if (name === 'forest') {
        // Bionic Steel preset
        // Dots
        setRadioVal('dots-type', 'extra-rounded');
        setRadioVal('dots-color-mode', 'gradient');
        solidChoice.classList.add('hidden');
        gradChoice.classList.remove('hidden');
        document.getElementById('dots-grad-color1').value = '#94a3b8';
        document.getElementById('dots-grad-color2').value = '#334155';
        document.getElementById('dots-grad-type').value = 'linear';
        document.getElementById('dots-grad-rotation').value = '135';
        dotsGradRotationVal.textContent = '135°';

        // Corners
        setRadioVal('corners-square-type', 'extra-rounded');
        document.getElementById('corners-square-color').value = '#475569';
        setRadioVal('corners-dot-type', 'dot');
        document.getElementById('corners-dot-color').value = '#94a3b8';

        // Background
        document.getElementById('bg-transparent').checked = false;
        document.getElementById('bg-color').value = '#ffffff';
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';

      } else if (name === 'royal') {
        // Copper Alloy preset
        // Dots
        setRadioVal('dots-type', 'classy');
        setRadioVal('dots-color-mode', 'gradient');
        solidChoice.classList.add('hidden');
        gradChoice.classList.remove('hidden');
        document.getElementById('dots-grad-color1').value = '#ea580c';
        document.getElementById('dots-grad-color2').value = '#7c2d12';
        document.getElementById('dots-grad-type').value = 'radial';
        document.getElementById('dots-grad-rotation').value = '0';
        dotsGradRotationVal.textContent = '0°';

        // Corners
        setRadioVal('corners-square-type', 'extra-rounded');
        document.getElementById('corners-square-color').value = '#7c2d12';
        setRadioVal('corners-dot-type', 'dot');
        document.getElementById('corners-dot-color').value = '#ea580c';

        // Background
        document.getElementById('bg-transparent').checked = false;
        document.getElementById('bg-color').value = '#ffffff';
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';

      } else if (name === 'standard') {
        // Default standard black and white
        setRadioVal('dots-type', 'square');
        setRadioVal('dots-color-mode', 'solid');
        solidChoice.classList.remove('hidden');
        gradChoice.classList.add('hidden');
        document.getElementById('dots-color').value = '#000000';

        // Corners
        setRadioVal('corners-square-type', 'square');
        document.getElementById('corners-square-color').value = '#000000';
        setRadioVal('corners-dot-type', 'square');
        document.getElementById('corners-dot-color').value = '#000000';

        // Background
        document.getElementById('bg-transparent').checked = false;
        document.getElementById('bg-color').value = '#ffffff';
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';
      }
      updateQR();
    }

    function setRadioVal(name, val) {
      const el = document.querySelector(`input[name="${name}"][value="${val}"]`);
      if (el) el.checked = true;
    }

    // --- RESET FUNCTION ---
    const resetBtn = document.getElementById('reset-btn');
    resetBtn.addEventListener('click', () => {
      // Reset forms
      document.getElementById('url-data').value = 'https://devcito.org';
      
      const textInputs = ['wifi-ssid', 'wifi-password', 'vcard-fn', 'vcard-ln', 'vcard-phone', 'vcard-email', 'vcard-org', 'vcard-title', 'vcard-url', 'email-to', 'email-subject', 'email-body', 'sms-phone', 'sms-message'];
      textInputs.forEach(id => {
        const input = document.getElementById(id);
        if (input) input.value = '';
      });
      document.getElementById('wifi-encryption').value = 'WPA';
      document.getElementById('wifi-hidden').checked = false;

      // Reset uploaded logo
      uploadedLogoDataUrl = null;
      logoFile.value = '';
      logoFilename.textContent = 'No file selected';
      logoRemoveBtn.classList.add('hidden');
      document.getElementById('logo-size').value = '20';
      logoSizeVal.textContent = '20%';
      document.getElementById('logo-margin').value = '5';
      logoMarginVal.textContent = '5px';
      document.getElementById('logo-clear').checked = true;

      // Apply standard preset
      applyPreset('standard');
      
      // Update active preset button styling
      presetBtns.forEach(b => {
        b.classList.remove('active', 'border-orange-500/30', 'bg-slate-950/50');
        b.classList.add('border-white/5', 'bg-slate-950/30');
      });
      const standardBtn = document.querySelector('[data-preset="standard"]');
      if (standardBtn) {
        standardBtn.classList.add('active', 'border-orange-500/30', 'bg-slate-950/50');
        standardBtn.classList.remove('border-white/5', 'bg-slate-950/30');
      }
    });

    // --- EXPORT FORMAT SELECTOR ---
    const formatBtns = document.querySelectorAll('.format-btn');
    formatBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        formatBtns.forEach(b => {
          b.classList.remove('border-orange-500/30', 'bg-orange-500/10', 'text-orange-400');
          b.classList.add('border-white/5', 'bg-slate-950/40', 'text-gray-400');
        });
        btn.classList.add('border-orange-500/30', 'bg-orange-500/10', 'text-orange-400');
        btn.classList.remove('border-white/5', 'bg-slate-950/40', 'text-gray-400');
        
        currentFormat = btn.getAttribute('data-format');
      });
    });

    // --- DOWNLOAD LOGIC ---
    const downloadBtn = document.getElementById('download-btn');
    downloadBtn.addEventListener('click', async () => {
      downloadBtn.disabled = true;
      const originalText = downloadBtn.innerHTML;
      downloadBtn.innerHTML = `
        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Downloading...
      `;
      
      try {
        await qrCode.download({
          name: `qreative_qr_${Date.now()}`,
          extension: currentFormat
        });
      } catch (err) {
        console.error('Error downloading QR code:', err);
      } finally {
        downloadBtn.innerHTML = originalText;
        downloadBtn.disabled = false;
      }
    });

    // --- COPY TO CLIPBOARD LOGIC (IMAGE) ---
    const copyBtn = document.getElementById('copy-btn');
    copyBtn.addEventListener('click', async () => {
      const canvas = qrTarget.querySelector('canvas');
      if (!canvas) {
        alert('Sorry, we couldn\'t find the QR code image to copy.');
        return;
      }

      copyBtn.disabled = true;
      const originalText = copyBtn.innerHTML;
      copyBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Copying...
      `;

      try {
        // We convert the canvas to a blob
        canvas.toBlob(async (blob) => {
          if (!blob) {
            alert('Failed to generate image to copy.');
            return;
          }
          try {
            // Write blob to Clipboard
            const data = [new ClipboardItem({ [blob.type]: blob })];
            await navigator.clipboard.write(data);
            
            // Show Success UI
            copyBtn.innerHTML = `
              <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Copied successfully!
            `;
          } catch (e) {
            console.error('Error writing image to clipboard:', e);
            alert('Error copying. Your browser might not support copying images to the clipboard.');
          } finally {
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
              copyBtn.disabled = false;
            }, 2500);
          }
        }, 'image/png');
      } catch (err) {
        console.error('Failed to copy canvas:', err);
        copyBtn.innerHTML = originalText;
        copyBtn.disabled = false;
      }
    });

    // Initialize with standard styling on mount
    applyPreset('standard');
    
    // Set isInitialized to true after initial setup
    setTimeout(() => {
      isInitialized = true;
    }, 100);
  });
</script>
