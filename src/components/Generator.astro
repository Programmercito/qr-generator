  /* Extra glow feedback for active preset / tab */
  .preset-btn.active {
    box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.25), 0 10px 30px -14px rgba(37, 99, 235, 0.5);
  }

  /* Contrast validation badge states */
  #contrast-badge.state-ok {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #34d399;
  }
  #contrast-badge.state-ok #contrast-dot { background: #34d399; }

  #contrast-badge.state-warn {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.25);
    color: #fbbf24;
  }
  #contrast-badge.state-warn #contrast-dot { background: #fbbf24; }

  #contrast-badge.state-bad {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
