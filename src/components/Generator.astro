<!-- Workspace Section -->
<section id="generator" class="cyber-grid relative w-full py-16 border-t border-b border-white/5 scroll-mt-20">
  <!-- Decorative Glows for this section specifically -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-blue-600/5 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Section Title -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/20 bg-blue-500/5 text-sky-300 text-xs font-semibold uppercase tracking-wider">
        Live Editor
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-black">
        Customize Your QR Code
      </h2>
      <p class="text-gray-400 text-sm">
        Modify the content, apply premium color schemes, or design your own style with a logo.
      </p>
    </div>

    <!-- Glowing Border Wrapper -->
    <div class="animated-glow-border shadow-2xl shadow-blue-500/5">
      <div class="animated-glow-border-content p-6 sm:p-8 lg:p-10">
        
        <div class="grid lg:grid-cols-12 gap-8 items-start">
          
          <!-- LEFT COLUMN: Controls (7 cols on lg) -->
          <section class="lg:col-span-7 space-y-6">
            
            <!-- SECTION 1: Content Type -->
            <div class="glass-card rounded-2xl p-6">
              <h2 class="font-display font-bold text-lg text-white mb-4 flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-blue-500/10 text-sky-300 text-sm">1</span>
                What do you want to encode?
              </h2>
              
              <!-- Content Tabs -->
              <div class="grid grid-cols-5 gap-1.5 p-1 rounded-xl bg-slate-950/50 border border-white/5 mb-6" role="tablist" aria-label="Content type">
                <button data-type="url" role="tab" aria-selected="true" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 active bg-white/5 text-sky-300 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                  <span>Link</span>
                </button>
                <button data-type="wifi" role="tab" aria-selected="false" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071a10.5 10.5 0 0114.14 0M1.34 6.344a16.5 16.5 0 0121.32 0" /></svg>
                  <span>WiFi</span>
                </button>
                <button data-type="vcard" role="tab" aria-selected="false" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M21 12h-4m4 4h-4" /></svg>
                  <span>Contact</span>
                </button>
                <button data-type="email" role="tab" aria-selected="false" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                  <span>Email</span>
                </button>
                <button data-type="sms" role="tab" aria-selected="false" class="tab-btn py-2 text-xs font-semibold rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all flex flex-col items-center gap-1 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                  <span>SMS</span>
                </button>
              </div>

              <!-- Content Forms -->
              <div class="content-forms">
                
                <!-- URL / Text Form -->
                <div id="form-url" class="form-container space-y-4">
                  <div>
                    <label for="url-data" class="block text-xs font-semibold text-gray-400 mb-2">URL Link or Text</label>
                    <textarea 
                      id="url-data" 
                      rows="3" 
                      class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors placeholder:text-gray-600"
                      placeholder="https://example.com or any text to encode..."
                    >https://devcito.org</textarea>
                  </div>
                </div>

                <!-- WiFi Form -->
                <div id="form-wifi" class="form-container space-y-4 hidden">
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="wifi-ssid" class="block text-xs font-semibold text-gray-400 mb-2">Network Name (SSID)</label>
                      <input type="text" id="wifi-ssid" class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500/50 transition-colors" placeholder="My WiFi Network" />
