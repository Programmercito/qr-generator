  #contrast-badge.state-bad #contrast-dot { background: #f87171; }

  #contrast-badge.state-info {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
  }
  #contrast-badge.state-info #contrast-dot { background: #94a3b8; }

  .tab-btn.active {
    box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.2);
  }

  /* Floating mobile bar show/hide */
