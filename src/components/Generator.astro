<script>
  // Dynamic import of qr-code-styling to support client-only execution in Astro
  document.addEventListener('DOMContentLoaded', async () => {
    let QRCodeStyling;
    try {
      const module = await import('qr-code-styling');
      QRCodeStyling = module.default;
    } catch (err) {
      console.error('Failed to load qr-code-styling module:', err);
      return;
    }

    const qrTarget = document.getElementById('qr-target');
    const qrSpinner = document.getElementById('qr-spinner');
    
    // Hide spinner once loaded
    if (qrSpinner) qrSpinner.style.display = 'none';

    // State Variables
    let currentDataType = 'url';
    let currentFormat = 'png';
    let uploadedLogoDataUrl = null;
    let isInitialized = false;
    let updateTimeout = null;
    let currentDecoShape = null;

    // Default configuration options
    const defaultOptions = {
      width: 280,
      height: 280,
      type: 'svg',
      data: 'https://devcito.org',
      margin: 8,
      qrOptions: {
        typeNumber: 0,
        mode: 'Byte',
        errorCorrectionLevel: 'H'
      },
      imageOptions: {
        hideBackgroundDots: true,
        imageSize: 0.2,
        margin: 5
      },
      dotsOptions: {
        type: 'rounded',
        color: '#000000'
      },
      backgroundOptions: {
        color: '#ffffff'
      },
      cornersSquareOptions: {
        type: 'extra-rounded',
        color: '#000000'
      },
      cornersDotOptions: {
        type: 'dot',
        color: '#000000'
      }
    };

    // Instantiate qr-code-styling
    const qrCode = new QRCodeStyling(defaultOptions);
    if (qrTarget) {
      qrCode.append(qrTarget);
    }

    // --- TOAST NOTIFICATIONS ---
    const toastContainer = document.getElementById('toast-container');
    const toastSuccessIcon = '<svg class="toast-icon w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>';
    const toastErrorIcon = '<svg class="toast-icon w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /></svg>';

    function showToast(message, type = 'success') {
      if (!toastContainer) return;
      const toast = document.createElement('div');
      toast.className = `toast ${type === 'error' ? 'toast-error' : 'toast-success'}`;
      toast.innerHTML = `${type === 'error' ? toastErrorIcon : toastSuccessIcon}<span>${message}</span>`;
      toastContainer.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('toast-out');
        setTimeout(() => toast.remove(), 260);
      }, 2400);
    }

    // --- MOBILE MINI PREVIEW ---
    const miniQr = document.getElementById('mini-qr');
    const miniFormat = document.getElementById('mini-format');
    const miniSize = document.getElementById('mini-size');

    function refreshMini() {
      if (!miniQr || !qrTarget) return;
      const svg = qrTarget.querySelector('svg');
      if (!svg) return;
      try {
        const clone = svg.cloneNode(true);
        clone.removeAttribute('style');
        clone.setAttribute('width', '120');
        clone.setAttribute('height', '120');
        miniQr.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(new XMLSerializer().serializeToString(clone));
      } catch (e) {
        // ignore mid-render failures
      }
    }

    // --- CONTRAST VALIDATION ---
    const contrastBadge = document.getElementById('contrast-badge');
    const contrastText = document.getElementById('contrast-text');

    // WCAG relative luminance from a hex color
    function relLuminance(hex) {
      const clean = hex.replace('#', '');
      const full = clean.length === 3 ? clean.split('').map(c => c + c).join('') : clean;
      const channels = [0, 2, 4].map(i => parseInt(full.slice(i, i + 2), 16) / 255)
        .map(c => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4)));
      return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
    }

    function contrastRatio(a, b) {
      const lumA = relLuminance(a);
      const lumB = relLuminance(b);
      const hi = Math.max(lumA, lumB);
      const lo = Math.min(lumA, lumB);
      return (hi + 0.05) / (lo + 0.05);
    }

    function updateContrastBadge() {
      if (!contrastBadge || !contrastText) return;

      const bgTransparent = document.getElementById('bg-transparent').checked;
      const colorMode = document.querySelector('input[name="dots-color-mode"]:checked')?.value || 'solid';
      const dotsColors = colorMode === 'gradient'
        ? [document.getElementById('dots-grad-color1').value, document.getElementById('dots-grad-color2').value]
        : [document.getElementById('dots-color').value];

      let state, message;

      if (bgTransparent) {
        state = 'info';
        message = 'Transparent background · verify contrast on the final surface';
      } else {
        const bgColor = document.getElementById('bg-color').value;
        // Worst case: the dot color with the lowest contrast against the background
        const ratio = Math.min(...dotsColors.map(c => contrastRatio(c, bgColor)));
        // Inverted QR (light modules on dark bg) is rejected by many scanners
        const inverted = dotsColors.every(c => relLuminance(c) > relLuminance(bgColor));

        if (inverted) {
          state = 'warn';
          message = `${ratio.toFixed(1)}:1 · Inverted colors, many scanners fail on this`;
        } else if (ratio >= 7) {
          state = 'ok';
          message = `${ratio.toFixed(1)}:1 · High contrast, print-ready`;
        } else if (ratio >= 4.5) {
          state = 'ok';
          message = `${ratio.toFixed(1)}:1 · Good contrast for scanning`;
        } else if (ratio >= 3) {
          state = 'warn';
          message = `${ratio.toFixed(1)}:1 · Weak contrast, may fail in low light`;
        } else {
          state = 'bad';
          message = `${ratio.toFixed(1)}:1 · Too low, this QR likely won't scan`;
        }
      }

      contrastBadge.classList.remove('state-ok', 'state-warn', 'state-bad', 'state-info');
      contrastBadge.classList.add(`state-${state}`);
      contrastText.textContent = message;
    }

    // --- DECORATIVE DOT GLYPHS ---
    // The library draws every dark module as a <rect x y w h> inside
    // clipPath[id^="clip-path-dot-color"]. We replace each rect with a glyph
    // path; the gradient/color rect that clips through it keeps working as-is.
    function polygonPath(cx, cy, n, radius, rotationDeg) {
      const pts = [];
      for (let i = 0; i < n; i++) {
        const a = ((rotationDeg + (i * 360) / n) * Math.PI) / 180;
        pts.push(`${(cx + radius * Math.cos(a)).toFixed(2)} ${(cy + radius * Math.sin(a)).toFixed(2)}`);
      }
      return `M ${pts.join(' L ')} Z`;
    }

    function starPath(cx, cy, points, outer, inner, rotationDeg) {
      const pts = [];
      for (let i = 0; i < points * 2; i++) {
        const r = i % 2 === 0 ? outer : inner;
        const a = ((rotationDeg + (i * 180) / points) * Math.PI) / 180;
        pts.push(`${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`);
      }
      return `M ${pts.join(' L ')} Z`;
    }

    const DECO_SHAPES = {
      'deco-heart': {
        d: (cx, cy, s) =>
          `M ${cx} ${(cy + s * 0.44).toFixed(2)} ` +
          `C ${(cx - s * 0.62).toFixed(2)} ${(cy - s * 0.02).toFixed(2)}, ${(cx - s * 0.34).toFixed(2)} ${(cy - s * 0.5).toFixed(2)}, ${cx} ${(cy - s * 0.2).toFixed(2)} ` +
          `C ${(cx + s * 0.34).toFixed(2)} ${(cy - s * 0.5).toFixed(2)}, ${(cx + s * 0.62).toFixed(2)} ${(cy - s * 0.02).toFixed(2)}, ${cx} ${(cy + s * 0.44).toFixed(2)} Z`
      },
      'deco-star': { d: (cx, cy, s) => starPath(cx, cy, 5, s * 0.62, s * 0.27, -90) },
      'deco-sparkle': { d: (cx, cy, s) => starPath(cx, cy, 4, s * 0.64, s * 0.18, -90) },
      'deco-diamond': { d: (cx, cy, s) => polygonPath(cx, cy, 4, s * 0.6, -90) },
      'deco-hexagon': { d: (cx, cy, s) => polygonPath(cx, cy, 6, s * 0.6, -90) },
      'deco-ring': {
        evenOdd: true,
        d: (cx, cy, s) => {
          const ro = s * 0.58, ri = s * 0.28;
          return (
            `M ${cx - ro} ${cy} a ${ro} ${ro} 0 1 0 ${ro * 2} 0 a ${ro} ${ro} 0 1 0 ${-ro * 2} 0 Z ` +
            `M ${cx - ri} ${cy} a ${ri} ${ri} 0 1 0 ${ri * 2} 0 a ${ri} ${ri} 0 1 0 ${-ri * 2} 0 Z`
          );
        }
      }
    };

    function applyDecorativeDots() {
      if (!currentDecoShape || !qrTarget) return;
      const def = DECO_SHAPES[currentDecoShape];
      if (!def) return;
      const svg = qrTarget.querySelector('svg');
      const clip = svg && svg.querySelector('clipPath[id^="clip-path-dot-color"]');
      if (!clip) return;
      clip.querySelectorAll('rect').forEach((rect) => {
        const x = parseFloat(rect.getAttribute('x'));
        const y = parseFloat(rect.getAttribute('y'));
        const size = parseFloat(rect.getAttribute('width'));
        if (!Number.isFinite(x) || !Number.isFinite(y) || !Number.isFinite(size) || size <= 0) return;
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', def.d(x + size / 2, y + size / 2, size));
        if (def.evenOdd) path.setAttribute('fill-rule', 'evenodd');
        rect.replaceWith(path);
      });
    }

    // --- EXPORT HELPERS (serialize the live SVG so DOM decorations survive) ---
    async function rasterizePx(px, bgFill) {
      if (!qrTarget) return null;
      const svg = qrTarget.querySelector('svg');
      if (!svg) return null;
      const clone = svg.cloneNode(true);
      clone.removeAttribute('style');
      clone.setAttribute('width', String(px));
      clone.setAttribute('height', String(px));
      const str = new XMLSerializer().serializeToString(clone);
      const url = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(str);
      const img = new Image();
      await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = () => reject(new Error('SVG rasterization failed'));
        img.src = url;
      });
      const canvas = document.createElement('canvas');
      canvas.width = px;
      canvas.height = px;
      const ctx = canvas.getContext('2d');
      if (bgFill) {
        ctx.fillStyle = bgFill;
        ctx.fillRect(0, 0, px, px);
      }
      ctx.drawImage(img, 0, 0, px, px);
      return canvas;
    }

    // Show the floating bar only while the generator section is on screen
    const mobileBar = document.getElementById('mobile-bar');
    const generatorSection = document.getElementById('generator');
    if (mobileBar && generatorSection && 'IntersectionObserver' in window) {
      const barObserver = new IntersectionObserver((entries) => {
        mobileBar.classList.toggle('bar-visible', entries[0].isIntersecting);
      }, { threshold: 0.08 });
      barObserver.observe(generatorSection);
    }

    // --- ACCORDION LOGIC ---
    const accordionToggles = document.querySelectorAll('.accordion-toggle');
    accordionToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const item = toggle.parentElement;
        const content = toggle.nextElementSibling;
        
        const isClosed = content.classList.contains('hidden');
        
        // Close all first
        document.querySelectorAll('.accordion-content').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('active'));
        document.querySelectorAll('.accordion-toggle').forEach(t => t.setAttribute('aria-expanded', 'false'));
        
        if (isClosed) {
          content.classList.remove('hidden');
          item.classList.add('active');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });
    // Open first accordion item by default
    const firstAccordion = document.querySelector('.accordion-item');
    if (firstAccordion) {
      firstAccordion.classList.add('active');
      firstAccordion.querySelector('.accordion-content').classList.remove('hidden');
      firstAccordion.querySelector('.accordion-toggle').setAttribute('aria-expanded', 'true');
    }

    // --- STATE UPDATE FUNCTION ---
    function updateQR() {
      // 1. Gather Data based on selected tab
      let qrData = 'https://devcito.org';
      if (currentDataType === 'url') {
        qrData = document.getElementById('url-data').value || 'https://devcito.org';
      } else if (currentDataType === 'wifi') {
        const ssid = document.getElementById('wifi-ssid').value || '';
        const pass = document.getElementById('wifi-password').value || '';
        const enc = document.getElementById('wifi-encryption').value || 'WPA';
        const hidden = document.getElementById('wifi-hidden').checked;
        qrData = `WIFI:S:${ssid};T:${enc};P:${pass};H:${hidden ? 'true' : 'false'};;`;
      } else if (currentDataType === 'vcard') {
        const fn = document.getElementById('vcard-fn').value || '';
        const ln = document.getElementById('vcard-ln').value || '';
        const phone = document.getElementById('vcard-phone').value || '';
        const email = document.getElementById('vcard-email').value || '';
        const org = document.getElementById('vcard-org').value || '';
        const title = document.getElementById('vcard-title').value || '';
        const url = document.getElementById('vcard-url').value || '';
        qrData = `BEGIN:VCARD\nVERSION:3.0\nN:${ln};${fn};;;\nFN:${fn} ${ln}\nORG:${org}\nTITLE:${title}\nTEL;TYPE=CELL:${phone}\nEMAIL;TYPE=PREF,INTERNET:${email}\nURL:${url}\nEND:VCARD`;
      } else if (currentDataType === 'email') {
        const to = document.getElementById('email-to').value || '';
        const sub = document.getElementById('email-subject').value || '';
        const body = document.getElementById('email-body').value || '';
        qrData = `mailto:${to}?subject=${encodeURIComponent(sub)}&body=${encodeURIComponent(body)}`;
      } else if (currentDataType === 'sms') {
        const phone = document.getElementById('sms-phone').value || '';
        const message = document.getElementById('sms-message').value || '';
        qrData = `SMSTO:${phone}:${message}`;
      }

      // 2. Gather Dot Styling Options
      const rawDotsShape = document.querySelector('input[name="dots-type"]:checked').value;
      // Decorative shapes are drawn by replacing each module glyph in the SVG clipPath,
      // while the library renders plain squares underneath.
      const isDecorative = rawDotsShape.startsWith('deco-');
      currentDecoShape = isDecorative ? rawDotsShape : null;
      const dotsShape = isDecorative ? 'square' : rawDotsShape;
      const dotsColorMode = document.querySelector('input[name="dots-color-mode"]:checked').value;
      
      let dotsOptionsObj = { type: dotsShape };
      if (dotsColorMode === 'solid') {
        dotsOptionsObj.color = document.getElementById('dots-color').value;
        dotsOptionsObj.gradient = null;
      } else {
        const color1 = document.getElementById('dots-grad-color1').value;
        const color2 = document.getElementById('dots-grad-color2').value;
        const type = document.getElementById('dots-grad-type').value;
        const rotation = parseInt(document.getElementById('dots-grad-rotation').value) * Math.PI / 180;
        
        dotsOptionsObj.color = color1; // fallback
        dotsOptionsObj.gradient = {
          type: type,
          rotation: rotation,
          colorStops: [
            { offset: 0, color: color1 },
            { offset: 1, color: color2 }
          ]
        };
      }

      // 3. Corner Options
      const cornerSquareShape = document.querySelector('input[name="corners-square-type"]:checked').value;
      const cornerSquareColor = document.getElementById('corners-square-color').value;
      const cornerDotShape = document.querySelector('input[name="corners-dot-type"]:checked').value;
      const cornerDotColor = document.getElementById('corners-dot-color').value;

      // 4. Background Options
      const bgTransparent = document.getElementById('bg-transparent').checked;
      const bgColor = bgTransparent ? 'transparent' : document.getElementById('bg-color').value;

      // 5. Logo options
      const logoSize = parseFloat(document.getElementById('logo-size').value) / 100;
      const logoMargin = parseInt(document.getElementById('logo-margin').value);
      const logoClear = document.getElementById('logo-clear').checked;

      // 6. Error correction level
      const eccLevel = document.getElementById('ecc-level')?.value || 'H';

      // Combine Options
      const updatedOptions = {
        data: qrData,
        qrOptions: {
          typeNumber: 0,
          mode: 'Byte',
          errorCorrectionLevel: eccLevel
        },
        dotsOptions: dotsOptionsObj,
        backgroundOptions: {
          color: bgColor
        },
        cornersSquareOptions: {
          type: cornerSquareShape,
          color: cornerSquareColor
        },
        cornersDotOptions: {
          type: cornerDotShape,
          color: cornerDotColor
        },
        image: uploadedLogoDataUrl || '',
        imageOptions: {
          hideBackgroundDots: logoClear,
          imageSize: logoSize,
          margin: logoMargin,
          crossOrigin: 'anonymous'
        }
      };

      // Set target background helper
      if (qrTarget) {
        qrTarget.style.backgroundColor = bgTransparent ? '#0f172a' : '#ffffff';
        // Add checkered overlay for transparency indicator if transparent
        if (bgTransparent) {
          qrTarget.style.backgroundImage = 'radial-gradient(rgba(255,255,255,0.15) 1px, transparent 0)';
          qrTarget.style.backgroundSize = '12px 12px';
        } else {
          qrTarget.style.backgroundImage = 'none';
        }
      }

      if (isInitialized && qrTarget) {
        if (!qrTarget.classList.contains('qr-updating')) {
          qrTarget.classList.remove('qr-flash');
          qrTarget.classList.add('qr-updating');
        }
      }

      updateContrastBadge();

      Promise.resolve(qrCode.update(updatedOptions))
        .then(() => {
          applyDecorativeDots();
          refreshMini();
        })
        .catch(() => {});

      if (isInitialized && qrTarget) {
        if (updateTimeout) {
          clearTimeout(updateTimeout);
        }
        
        updateTimeout = setTimeout(() => {
          if (qrTarget) {
            qrTarget.classList.remove('qr-updating');
            qrTarget.classList.add('qr-flash');
            
            // Remove flash class after its animation ends
            setTimeout(() => {
              if (qrTarget) {
                qrTarget.classList.remove('qr-flash');
              }
            }, 600);
          }
        }, 300);
      }
    }

    // --- FORM SWITCHING LOGIC ---
    const tabBtns = document.querySelectorAll('.tab-btn');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle tabs active class
        tabBtns.forEach(b => {
          b.classList.remove('active', 'bg-white/5', 'text-sky-300');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active', 'bg-white/5', 'text-sky-300');
        btn.setAttribute('aria-selected', 'true');

        // Toggle visibility of target forms
        const targetType = btn.getAttribute('data-type');
        currentDataType = targetType;
        
        // Hide all first
        const allForms = document.querySelectorAll('.content-forms > div');
        allForms.forEach(f => f.classList.add('hidden'));
        
        // Show target
        const targetForm = document.getElementById(`form-${targetType}`);
        if (targetForm) {
          targetForm.classList.remove('hidden');
        }
        
        updateQR();
      });
    });

    // --- COLOR MODE SWITCHING ---
    const colorModeRadios = document.querySelectorAll('input[name="dots-color-mode"]');
    const solidChoice = document.getElementById('dots-solid-options');
    const gradChoice = document.getElementById('dots-gradient-options');
    
    colorModeRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        if (e.target.value === 'solid') {
          solidChoice.classList.remove('hidden');
          gradChoice.classList.add('hidden');
        } else {
          solidChoice.classList.add('hidden');
          gradChoice.classList.remove('hidden');
        }
        updateQR();
      });
    });

    // --- BACKGROUND TRANSPARENCY TOGGLE ---
    const bgTransparentCheckbox = document.getElementById('bg-transparent');
    const bgColorWrapper = document.getElementById('bg-color-picker-wrapper');
    bgTransparentCheckbox.addEventListener('change', (e) => {
      if (e.target.checked) {
        bgColorWrapper.style.opacity = '0.3';
        bgColorWrapper.style.pointerEvents = 'none';
      } else {
        bgColorWrapper.style.opacity = '1';
        bgColorWrapper.style.pointerEvents = 'auto';
      }
      updateQR();
    });

    // --- LOGO UPLOAD & PROCESSING ---
    const logoFile = document.getElementById('logo-file');
    const logoUploadBtn = document.getElementById('logo-upload-btn');
    const logoRemoveBtn = document.getElementById('logo-remove-btn');
    const logoFilename = document.getElementById('logo-filename');

    logoUploadBtn.addEventListener('click', () => logoFile.click());
    
    logoFile.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        logoFilename.textContent = file.name;
        logoRemoveBtn.classList.remove('hidden');
        
        const reader = new FileReader();
        reader.onload = (event) => {
          uploadedLogoDataUrl = event.target.result;
          updateQR();
        };
        reader.readAsDataURL(file);
      }
    });

    logoRemoveBtn.addEventListener('click', () => {
      uploadedLogoDataUrl = null;
      logoFile.value = '';
      logoFilename.textContent = 'No file selected';
      logoRemoveBtn.classList.add('hidden');
      updateQR();
    });

    // --- LOGO SLIDERS REAL-TIME DISPLAY ---
    const logoSizeSlider = document.getElementById('logo-size');
    const logoSizeVal = document.getElementById('logo-size-val');
    logoSizeSlider.addEventListener('input', (e) => {
      logoSizeVal.textContent = `${e.target.value}%`;
      updateQR();
    });

    const logoMarginSlider = document.getElementById('logo-margin');
    const logoMarginVal = document.getElementById('logo-margin-val');
    logoMarginSlider.addEventListener('input', (e) => {
      logoMarginVal.textContent = `${e.target.value}px`;
      updateQR();
    });

    const dotsGradRotationSlider = document.getElementById('dots-grad-rotation');
    const dotsGradRotationVal = document.getElementById('dots-grad-rotation-value');
    dotsGradRotationSlider.addEventListener('input', (e) => {
      dotsGradRotationVal.textContent = `${e.target.value}°`;
      updateQR();
    });

    // --- INPUT EVENT LISTENERS ---
    const inputsToWatch = [
      'url-data', 'wifi-ssid', 'wifi-password', 'wifi-encryption', 'wifi-hidden',
      'vcard-fn', 'vcard-ln', 'vcard-phone', 'vcard-email', 'vcard-org', 'vcard-title', 'vcard-url',
      'email-to', 'email-subject', 'email-body',
      'sms-phone', 'sms-message',
      'dots-color', 'dots-grad-color1', 'dots-grad-color2', 'dots-grad-type', 'dots-grad-rotation',
      'corners-square-color', 'corners-dot-color', 'bg-color', 'logo-clear', 'ecc-level'
    ];
    inputsToWatch.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', updateQR);
        el.addEventListener('change', updateQR);
      }
    });

    const radiosToWatch = ['dots-type', 'corners-square-type', 'corners-dot-type'];
    radiosToWatch.forEach(name => {
      document.querySelectorAll(`input[name="${name}"]`).forEach(radio => {
        radio.addEventListener('change', updateQR);
      });
    });

    // --- DESIGN PRESETS HANDLER ---
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle Active
        presetBtns.forEach(b => {
          b.classList.remove('active', 'border-blue-500/30', 'bg-slate-950/50');
          b.classList.add('border-white/5', 'bg-slate-950/30');
        });
        btn.classList.add('active', 'border-blue-500/30', 'bg-slate-950/50');
        btn.classList.remove('border-white/5', 'bg-slate-950/30');

        const preset = btn.getAttribute('data-preset');
        applyPreset(preset);
      });
    });

    // --- DESIGN PRESETS CONFIG ---
    // To add a preset: extend this map and add a button with data-preset="<key>".
    const PRESETS = {
      sunset:    { dotsType: 'classy-rounded', mode: 'gradient', c1: '#f97316', c2: '#27272a', gradType: 'linear', rot: 45,  sqType: 'extra-rounded', sqColor: '#f97316', dotType: 'dot',    dotColor: '#71717a', bg: '#ffffff' },
      cyberpunk: { dotsType: 'dots',           mode: 'gradient', c1: '#00f5ff', c2: '#3f3f46', gradType: 'linear', rot: 90,  sqType: 'square',        sqColor: '#00f5ff', dotType: 'square', dotColor: '#71717a', bg: '#07080a' },
      midnight:  { dotsType: 'rounded',        mode: 'solid',   solid: '#18181b',                                              sqType: 'extra-rounded', sqColor: '#18181b', dotType: 'dot',    dotColor: '#27272a', bg: '#f4f4f5' },
      forest:    { dotsType: 'extra-rounded',  mode: 'gradient', c1: '#94a3b8', c2: '#334155', gradType: 'linear', rot: 135, sqType: 'extra-rounded', sqColor: '#475569', dotType: 'dot',    dotColor: '#94a3b8', bg: '#ffffff' },
      royal:     { dotsType: 'classy',         mode: 'gradient', c1: '#ea580c', c2: '#7c2d12', gradType: 'radial', rot: 0,   sqType: 'extra-rounded', sqColor: '#7c2d12', dotType: 'dot',    dotColor: '#ea580c', bg: '#ffffff' },
      ocean:     { dotsType: 'extra-rounded',  mode: 'gradient', c1: '#2563eb', c2: '#06b6d4', gradType: 'linear', rot: 45,  sqType: 'extra-rounded', sqColor: '#2563eb', dotType: 'dot',    dotColor: '#06b6d4', bg: '#ffffff' },
      ink:       { dotsType: 'rounded',        mode: 'gradient', c1: '#312e81', c2: '#0ea5e9', gradType: 'linear', rot: 90,  sqType: 'dot',           sqColor: '#0ea5e9', dotType: 'dot',    dotColor: '#312e81', bg: '#ffffff' },
      jade:      { dotsType: 'classy-rounded', mode: 'gradient', c1: '#10b981', c2: '#134e4a', gradType: 'linear', rot: 135, sqType: 'square',        sqColor: '#134e4a', dotType: 'square', dotColor: '#10b981', bg: '#ffffff' },
      rose:      { dotsType: 'dots',           mode: 'gradient', c1: '#f43f5e', c2: '#fbbf24', gradType: 'radial', rot: 0,   sqType: 'extra-rounded', sqColor: '#f43f5e', dotType: 'dot',    dotColor: '#fbbf24', bg: '#ffffff' },
      violet:    { dotsType: 'dots',           mode: 'gradient', c1: '#8b5cf6', c2: '#d946ef', gradType: 'radial', rot: 0,   sqType: 'dot',           sqColor: '#8b5cf6', dotType: 'square', dotColor: '#d946ef', bg: '#ffffff' },
      executive: { dotsType: 'extra-rounded',  mode: 'solid',   solid: '#1e293b',                                              sqType: 'extra-rounded', sqColor: '#1e293b', dotType: 'dot',    dotColor: '#0f172a', bg: '#f8fafc' },
      standard:  { dotsType: 'square',         mode: 'solid',   solid: '#000000',                                              sqType: 'square',        sqColor: '#000000', dotType: 'square', dotColor: '#000000', bg: '#ffffff' }
    };

    function applyPreset(name) {
      const p = PRESETS[name] || PRESETS.standard;

      // Dots
      setRadioVal('dots-type', p.dotsType);
      setRadioVal('dots-color-mode', p.mode);
      if (p.mode === 'gradient') {
        solidChoice.classList.add('hidden');
        gradChoice.classList.remove('hidden');
        document.getElementById('dots-grad-color1').value = p.c1;
        document.getElementById('dots-grad-color2').value = p.c2;
        document.getElementById('dots-grad-type').value = p.gradType;
        document.getElementById('dots-grad-rotation').value = p.rot;
        dotsGradRotationVal.textContent = p.rot + String.fromCharCode(176);
      } else {
        solidChoice.classList.remove('hidden');
        gradChoice.classList.add('hidden');
        document.getElementById('dots-color').value = p.solid;
      }

      // Corners
      setRadioVal('corners-square-type', p.sqType);
      document.getElementById('corners-square-color').value = p.sqColor;
      setRadioVal('corners-dot-type', p.dotType);
      document.getElementById('corners-dot-color').value = p.dotColor;

      // Background (every preset ships an explicit, scannable background)
      document.getElementById('bg-transparent').checked = false;
      document.getElementById('bg-color').value = p.bg;
      bgColorWrapper.style.opacity = '1';
      bgColorWrapper.style.pointerEvents = 'auto';

      updateQR();
    }

    function setRadioVal(name, val) {
      const el = document.querySelector(`input[name="${name}"][value="${val}"]`);
      if (el) el.checked = true;
    }

    // --- RESET FUNCTION ---
    const resetBtn = document.getElementById('reset-btn');
    resetBtn.addEventListener('click', () => {
      // Reset forms
      document.getElementById('url-data').value = 'https://devcito.org';
      
      const textInputs = ['wifi-ssid', 'wifi-password', 'vcard-fn', 'vcard-ln', 'vcard-phone', 'vcard-email', 'vcard-org', 'vcard-title', 'vcard-url', 'email-to', 'email-subject', 'email-body', 'sms-phone', 'sms-message'];
      textInputs.forEach(id => {
        const input = document.getElementById(id);
        if (input) input.value = '';
      });
      document.getElementById('wifi-encryption').value = 'WPA';
      document.getElementById('wifi-hidden').checked = false;

      // Reset uploaded logo
      uploadedLogoDataUrl = null;
      logoFile.value = '';
      logoFilename.textContent = 'No file selected';
      logoRemoveBtn.classList.add('hidden');
      document.getElementById('logo-size').value = '20';
      logoSizeVal.textContent = '20%';
      document.getElementById('logo-margin').value = '5';
      logoMarginVal.textContent = '5px';
      document.getElementById('logo-clear').checked = true;

      // Apply standard preset
      applyPreset('standard');
      
      // Update active preset button styling
      presetBtns.forEach(b => {
        b.classList.remove('active', 'border-blue-500/30', 'bg-slate-950/50');
        b.classList.add('border-white/5', 'bg-slate-950/30');
      });
      const standardBtn = document.querySelector('[data-preset="standard"]');
      if (standardBtn) {
        standardBtn.classList.add('active', 'border-blue-500/30', 'bg-slate-950/50');
        standardBtn.classList.remove('border-white/5', 'bg-slate-950/30');
      }
    });

    const formatBtns = document.querySelectorAll('.format-btn');
    formatBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        formatBtns.forEach(b => {
          b.classList.remove('border-blue-500/30', 'bg-blue-500/10', 'text-sky-300');
          b.classList.add('border-white/5', 'bg-slate-950/40', 'text-gray-400');
        });
        btn.classList.add('border-blue-500/30', 'bg-blue-500/10', 'text-sky-300');
        btn.classList.remove('border-white/5', 'bg-slate-950/40', 'text-gray-400');
        
        currentFormat = btn.getAttribute('data-format');
        if (miniFormat) miniFormat.textContent = currentFormat.toUpperCase();
      });
    });

    // --- EXPORT RESOLUTION SLIDER (affects downloads, not the live preview) ---
    const exportSizeSlider = document.getElementById('export-size');
    const exportSizeVal = document.getElementById('export-size-val');
    if (exportSizeSlider) {
      exportSizeSlider.addEventListener('input', (e) => {
        exportSizeVal.textContent = `${e.target.value}px`;
        if (miniSize) miniSize.textContent = `${e.target.value}px`;
      });
    }

    // --- DOWNLOAD LOGIC (shared by desktop and mobile bar buttons) ---
    // Custom export: the library's own download() re-renders from the QR matrix
    // and would lose our decorative glyphs, so we serialize the live SVG instead.
    async function performDownload(btn) {
      btn.disabled = true;
      const originalText = btn.innerHTML;
      btn.innerHTML = `
        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Preparing...
      `;

      const exportSize = parseInt(exportSizeSlider?.value || '1024', 10);

      try {
        let blob;
        if (currentFormat === 'svg') {
          const svg = qrTarget && qrTarget.querySelector('svg');
          if (!svg) throw new Error('QR not rendered yet');
          const str = '<?xml version="1.0" encoding="UTF-8"?>\n' + new XMLSerializer().serializeToString(svg);
          blob = new Blob([str], { type: 'image/svg+xml;charset=utf-8' });
        } else {
          // JPEG needs an opaque background; PNG keeps alpha (or the chosen bg color)
          let bgFill = null;
          if (currentFormat === 'jpeg') {
            bgFill = document.getElementById('bg-transparent').checked
              ? '#ffffff'
              : document.getElementById('bg-color').value;
          }
          const canvas = await rasterizePx(exportSize, bgFill);
          if (!canvas) throw new Error('QR not rendered yet');
          blob = await new Promise((resolve) =>
            canvas.toBlob(resolve, currentFormat === 'jpeg' ? 'image/jpeg' : 'image/png', 0.92)
          );
          if (!blob) throw new Error('Blob generation failed');
        }

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `qreative_qr_${Date.now()}.${currentFormat}`;
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 2000);

        showToast(`Downloaded as ${currentFormat.toUpperCase()}${currentFormat !== 'svg' ? ` (${exportSize}px)` : ''}`);
      } catch (err) {
        console.error('Error downloading QR code:', err);
        showToast('Download failed. Please try again.', 'error');
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }

    const downloadBtn = document.getElementById('download-btn');
    downloadBtn.addEventListener('click', () => performDownload(downloadBtn));

    const mobileDownloadBtn = document.getElementById('mobile-download-btn');
    if (mobileDownloadBtn) {
      mobileDownloadBtn.addEventListener('click', () => performDownload(mobileDownloadBtn));
    }

    // --- COPY TO CLIPBOARD LOGIC (IMAGE) ---
    const copyBtn = document.getElementById('copy-btn');
    copyBtn.addEventListener('click', async () => {
      const svgEl = qrTarget && qrTarget.querySelector('svg');
      if (!svgEl) {
        showToast('QR image is not ready yet. Try again in a second.', 'error');
        return;
      }

      copyBtn.disabled = true;
      const originalText = copyBtn.innerHTML;
      copyBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Copying...
      `;

      try {
        const canvas = await rasterizePx(1024, null);
        if (!canvas) throw new Error('QR not rendered');

        const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
        if (!blob) throw new Error('Blob generation failed');

        await navigator.clipboard.write([new ClipboardItem({ [blob.type]: blob })]);

        // Show Success UI
        copyBtn.innerHTML = `
          <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          Copied successfully!
        `;
        showToast('QR copied to clipboard');
      } catch (err) {
        console.error('Error copying image to clipboard:', err);
        showToast('Your browser doesn\'t support copying images.', 'error');
      } finally {
        setTimeout(() => {
          copyBtn.innerHTML = originalText;
          copyBtn.disabled = false;
        }, 2500);
      }
    });

    // Initialize with standard styling on mount
    applyPreset('standard');
    
    // Set isInitialized to true after initial setup
    setTimeout(() => {
      isInitialized = true;
    }, 100);
  });
</script>
