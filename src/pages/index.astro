---
import Layout from '../layouts/Layout.astro';
import Generator from '../components/Generator.astro';
---

<Layout title="Qreative - Beautiful & Customized QR Codes for Free" description="Design premium QR codes for free and privately. Choose gradients, custom dot shapes, upload your logo and export in SVG, PNG or JPEG. All in your browser.">
  
  <!-- Background Glows -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-orange-600/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-[20%] right-1/4 w-96 h-96 bg-amber-500/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <!-- Header -->
  <header class="sticky top-0 z-50 w-full border-b border-white/5 bg-[#07080a]/60 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-6 h-18 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 font-display font-black text-2xl tracking-tight text-white group">
        <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-orange-600 to-amber-500 flex items-center justify-center shadow-lg shadow-orange-500/20 group-hover:rotate-6 transition-transform">
          <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="5" height="5" x="3" y="3" rx="1" />
            <rect width="5" height="5" x="16" y="3" rx="1" />
            <rect width="5" height="5" x="3" y="16" rx="1" />
            <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
            <path d="M21 21v-3" />
            <path d="M12 7v5" />
            <path d="M12 17h.01" />
          </svg>
        </div>
        <span>Qreative</span>
      </a>
      
      <a 
        href="#generator" 
        class="relative inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-medium text-sm text-white overflow-hidden group shadow-lg shadow-orange-500/10 hover:shadow-orange-500/20 transition-all duration-300"
      >
        <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-orange-600 to-amber-500 group-hover:from-orange-500 group-hover:to-amber-400 transition-colors"></span>
        <span class="relative flex items-center gap-1.5">
          Create QR Free
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </span>
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="flex-grow">
    <section class="max-w-7xl mx-auto px-6 py-12 lg:py-0 lg:h-[calc(100vh-4.5rem)] lg:min-h-[680px] grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy -->
      <div class="lg:col-span-7 flex flex-col space-y-6 lg:space-y-8 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-orange-500/30 bg-orange-500/5 text-orange-400 text-xs font-semibold tracking-wide w-fit">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-ping"></span>
          100% Free & Local Generator
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Design QR codes people <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 via-amber-400 to-yellow-300">actually want to scan</span>
        </h1>
        
        <p class="text-gray-400 text-base sm:text-lg lg:text-xl leading-relaxed max-w-xl">
          Add personality to your links, social media, and contact cards. Customize colors, gradients, dot shapes, upload your logo, and download print-ready high-resolution SVG files.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a 
            href="#generator" 
            id="start-generator-btn"
            class="glow-btn relative inline-flex items-center justify-center px-8 py-4 rounded-xl font-bold text-white bg-gradient-to-r from-orange-600 via-amber-500 to-yellow-500 shadow-xl shadow-orange-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 text-center"
          >
            Start Generating
          </a>
          <a 
            href="#features" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl font-bold text-gray-300 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all duration-200 text-center"
          >
            View Features
          </a>
        </div>
        
        <!-- Social Proof/Stats -->
        <div class="grid grid-cols-3 gap-4 sm:gap-6 pt-6 lg:pt-8 border-t border-white/5 max-w-lg">
          <div>
            <div class="font-display font-bold text-xl sm:text-2xl text-white">0%</div>
            <div class="text-[11px] sm:text-xs text-gray-500 mt-1">Serverless (100% private)</div>
          </div>
          <div>
            <div class="font-display font-bold text-xl sm:text-2xl text-white">SVG</div>
            <div class="text-[11px] sm:text-xs text-gray-500 mt-1">Vector format ready</div>
          </div>
          <div>
            <div class="font-display font-bold text-xl sm:text-2xl text-white">Free</div>
            <div class="text-[11px] sm:text-xs text-gray-500 mt-1">No watermarks</div>
          </div>
        </div>
      </div>
      
      <!-- Right Column: Interactive Mockup -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-[420px] aspect-square rounded-3xl p-1 bg-gradient-to-tr from-orange-500/20 via-amber-500/10 to-transparent group">
          
          <!-- Decorative Blur Glow behind the QR mockup -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-orange-600 via-amber-500 to-yellow-500 opacity-20 blur-xl group-hover:opacity-35 transition duration-500"></div>
          
          <!-- Mockup Container -->
          <div class="relative h-full w-full rounded-[22px] bg-zinc-950/90 backdrop-blur-xl p-8 flex flex-col justify-between items-center border border-white/10">
            <!-- Mock Header -->
            <div class="w-full flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
              </div>
              <span class="text-xs font-medium text-orange-400 font-mono">carbon_stealth.svg</span>
            </div>
            
            <!-- Beautiful Stylized QR Mockup -->
            <div class="relative my-6 p-6 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center w-full max-w-[240px] aspect-square group-hover:scale-105 transition-transform duration-500 shadow-inner">
              <svg class="w-full h-full text-white" viewBox="0 0 100 100" fill="none">
                <!-- Outer Ring Corner Top-Left -->
                <rect x="5" y="5" width="24" height="24" rx="6" fill="url(#mock-grad)" />
                <rect x="9" y="9" width="16" height="16" rx="3" fill="#0f172a" />
                <rect x="12" y="12" width="10" height="10" rx="1.5" fill="url(#mock-grad)" />
                
                <!-- Outer Ring Corner Top-Right -->
                <rect x="71" y="5" width="24" height="24" rx="6" fill="url(#mock-grad)" />
                <rect x="75" y="9" width="16" height="16" rx="3" fill="#0f172a" />
                <rect x="78" y="12" width="10" height="10" rx="1.5" fill="url(#mock-grad)" />

                <!-- Outer Ring Corner Bottom-Left -->
                <rect x="5" y="71" width="24" height="24" rx="6" fill="url(#mock-grad)" />
                <rect x="9" y="75" width="16" height="16" rx="3" fill="#0f172a" />
                <rect x="12" y="78" width="10" height="10" rx="1.5" fill="url(#mock-grad)" />

                <!-- Dotted Matrix Pattern (beautiful mockup representation) -->
                <!-- Row 1 -->
                <circle cx="38" cy="8" r="2.5" fill="url(#mock-grad)" />
                <circle cx="48" cy="8" r="2.5" fill="url(#mock-grad)" />
                <circle cx="58" cy="8" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 2 -->
                <circle cx="38" cy="18" r="2.5" fill="url(#mock-grad)" />
                <circle cx="58" cy="18" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 3 -->
                <circle cx="38" cy="28" r="2.5" fill="url(#mock-grad)" />
                <circle cx="48" cy="28" r="2.5" fill="url(#mock-grad)" />
                <circle cx="58" cy="28" r="2.5" fill="url(#mock-grad)" />
                <circle cx="68" cy="28" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 4 -->
                <circle cx="8" cy="38" r="2.5" fill="url(#mock-grad)" />
                <circle cx="18" cy="38" r="2.5" fill="url(#mock-grad)" />
                <circle cx="28" cy="38" r="2.5" fill="url(#mock-grad)" />
                <circle cx="48" cy="38" r="2.5" fill="url(#mock-grad)" />
                <circle cx="58" cy="38" r="2.5" fill="url(#mock-grad)" />
                <circle cx="78" cy="38" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 5 -->
                <circle cx="18" cy="48" r="2.5" fill="url(#mock-grad)" />
                <circle cx="28" cy="48" r="2.5" fill="url(#mock-grad)" />
                <circle cx="38" cy="48" r="2.5" fill="url(#mock-grad)" />
                <circle cx="68" cy="48" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 6 -->
                <circle cx="8" cy="58" r="2.5" fill="url(#mock-grad)" />
                <circle cx="38" cy="58" r="2.5" fill="url(#mock-grad)" />
                <circle cx="48" cy="58" r="2.5" fill="url(#mock-grad)" />
                <circle cx="58" cy="58" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 7 -->
                <circle cx="38" cy="68" r="2.5" fill="url(#mock-grad)" />
                <circle cx="48" cy="68" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 8 (below) -->
                <circle cx="68" cy="78" r="2.5" fill="url(#mock-grad)" />
                <circle cx="78" cy="78" r="2.5" fill="url(#mock-grad)" />
                <!-- Row 9 -->
                <circle cx="48" cy="88" r="2.5" fill="url(#mock-grad)" />
                <circle cx="58" cy="88" r="2.5" fill="url(#mock-grad)" />
                <circle cx="88" cy="88" r="2.5" fill="url(#mock-grad)" />

                <!-- Mock Logo Centered -->
                <rect x="36" y="36" width="28" height="28" rx="8" fill="#090a0f" stroke="url(#mock-grad)" stroke-width="1.5" />
                <svg x="43" y="43" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#mock-grad)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>

                <defs>
                  <linearGradient id="mock-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#f97316" />
                    <stop offset="50%" stop-color="#f59e0b" />
                    <stop offset="100%" stop-color="#ff0055" />
                  </linearGradient>
                </defs>
              </svg>
            </div>
            
            <!-- Controls Mock -->
            <div class="w-full space-y-2 mt-2">
              <div class="flex justify-between items-center text-xs text-gray-500">
                <span>Dot style</span>
                <span class="text-gray-300 font-medium">Classy Lines</span>
              </div>
              <div class="w-full h-1 bg-white/10 rounded-full overflow-hidden">
                <div class="w-3/4 h-full bg-gradient-to-r from-orange-500 to-amber-500"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </section>

    <!-- Features Section -->
    <section id="features" class="relative max-w-7xl mx-auto px-6 py-24 border-t border-white/5 scroll-mt-18">
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-20">
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Everything you need to create extraordinary QRs
        </h2>
        <p class="text-gray-400 text-lg">
          No signup, no limits, and your data never leaves your computer.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <!-- Feature 1 -->
        <div class="glass-card p-8 rounded-2xl flex flex-col space-y-4 hover:border-orange-500/30 transition-colors group">
          <div class="h-12 w-12 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-400 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-lg text-white">Modular Design</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Customize the dot pattern, the shape of the outer frames, and the inner corner dots.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="glass-card p-8 rounded-2xl flex flex-col space-y-4 hover:border-amber-500/30 transition-colors group">
          <div class="h-12 w-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-lg text-white">Insert Your Logo</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Upload your brand, adjust its size, and clear the background dots automatically for the logo to stand out.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="glass-card p-8 rounded-2xl flex flex-col space-y-4 hover:border-zinc-500/30 transition-colors group">
          <div class="h-12 w-12 rounded-xl bg-zinc-700/10 border border-zinc-700/20 flex items-center justify-center text-zinc-400 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8m-5 5h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293h3.172a1 1 0 00.707-.293l2.414-2.414a1 1 0 01.707-.293H20" />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-lg text-white">Vector Export</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Download in SVG format, ideal for large banners and printed flyers, or traditional web formats like PNG and JPEG.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="glass-card p-8 rounded-2xl flex flex-col space-y-4 hover:border-emerald-500/30 transition-colors group">
          <div class="h-12 w-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-lg text-white">Absolute Privacy</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            The generation runs entirely in your browser. Your links, passwords, and data never touch the internet.
          </p>
        </div>

      </div>
    </section>

    <Generator />
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/5 bg-[#040507] py-8 text-center text-xs text-gray-500">
    <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        &copy; 2026 Qreative. Open source & private QR Code Generator.
      </div>
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1">
          Made with ❤️ by <a href="https://devcito.org" target="_blank" class="text-orange-500 hover:text-orange-400 font-semibold transition-colors">devcito</a>
        </span>
      </div>
    </div>
  </footer>

</Layout>
